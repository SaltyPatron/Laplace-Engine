LP_SQL(SHOW_DATA_DIR, 0, "SHOW data_directory")
LP_SQL(DB_SIZE_BYTES, 0, "SELECT pg_catalog.pg_database_size(pg_catalog.current_database())::bigint")
LP_SQL(DB_EXISTS, 1, "SELECT 1 FROM pg_catalog.pg_database WHERE datname = $1::name")
LP_SQL(EXT_INSTALLED_INFO, 0,
    "SELECT (SELECT n.nspname FROM pg_catalog.pg_extension e JOIN pg_catalog.pg_namespace n ON n.oid = e.extnamespace WHERE e.extname = 'laplace'),"
    " current_setting('max_identifier_length')::integer")
LP_SQL(EXT_VERSIONS, 0,
    "SELECT e.extversion, a.default_version"
    " FROM pg_catalog.pg_extension e"
    " JOIN pg_catalog.pg_available_extensions a ON a.name = e.extname"
    " WHERE e.extname = 'laplace'")
LP_SQL(EXT_UPDATE_PATH, 0,
    "SELECT count(*)::integer FROM pg_catalog.pg_extension e"
    " JOIN pg_catalog.pg_available_extensions a ON a.name = e.extname"
    " JOIN pg_catalog.pg_extension_update_paths('laplace') u ON u.source = e.extversion AND u.target = a.default_version"
    " WHERE e.extname = 'laplace' AND u.path IS NOT NULL")
LP_SQL(EXT_CONTROL_DIR, 0,
    "WITH paths AS (SELECT p, o FROM pg_catalog.unnest(pg_catalog.string_to_array(pg_catalog.current_setting('extension_control_path'),"
    "  CASE WHEN pg_catalog.current_setting('data_directory') ~ '^[A-Za-z]:' THEN ';' ELSE ':' END)) WITH ORDINALITY AS u(p, o)),"
    " controls AS (SELECT CASE WHEN p = '$system' THEN (SELECT setting FROM pg_catalog.pg_config WHERE name = 'SHAREDIR') ELSE p END"
    "  || '/extension' AS d, o FROM paths)"
    " SELECT d FROM controls WHERE (pg_catalog.pg_stat_file(d || '/laplace.control', true)).size IS NOT NULL ORDER BY o LIMIT 1")
LP_SQL(EXT_STORAGE_COMPAT, 1,
    "SELECT COALESCE(("
    " SELECT"
    "  pg_catalog.obj_description(pg_catalog.to_regclass(ext.ns || '.entity'), 'pg_class') = $1::text"
    "  OR ("
    "    pg_catalog.to_regclass(ext.ns || '.entity') IS NOT NULL"
    "    AND (pg_catalog.obj_description(pg_catalog.to_regclass(ext.ns || '.entity'), 'pg_class') IS NULL"
    "         OR pg_catalog.obj_description(pg_catalog.to_regclass(ext.ns || '.entity'), 'pg_class') LIKE 'laplace-storage:%')"
    "    AND EXISTS (SELECT 1 FROM pg_catalog.pg_type t WHERE t.typnamespace = ext.nsoid AND t.typname = 'blake3' AND t.typlen = 16)"
    "    AND (SELECT p.partstrat::text || ':' || (SELECT count(*) FROM pg_catalog.pg_inherits i WHERE i.inhparent = c.oid)"
    "         FROM pg_catalog.pg_class c JOIN pg_catalog.pg_partitioned_table p ON p.partrelid = c.oid"
    "         WHERE c.relnamespace = ext.nsoid AND c.relname = 'entity') = 'r:9'"
    "    AND (SELECT pg_catalog.string_agg(a.attname, ',' ORDER BY a.attnum)"
    "         FROM pg_catalog.pg_attribute a JOIN pg_catalog.pg_class c ON c.oid = a.attrelid"
    "         WHERE c.relnamespace = ext.nsoid AND c.relname = 'entity' AND a.attnum > 0 AND NOT a.attisdropped) = 'id,tier,coord,hilbert,mask'"
    "    AND (SELECT p.partstrat::text || ':' || (SELECT count(*) FROM pg_catalog.pg_inherits i WHERE i.inhparent = c.oid)"
    "         FROM pg_catalog.pg_class c JOIN pg_catalog.pg_partitioned_table p ON p.partrelid = c.oid"
    "         WHERE c.relnamespace = ext.nsoid AND c.relname = 'physicality') = 'r:9'"
    "    AND (SELECT pg_catalog.string_agg(a.attname, ',' ORDER BY a.attnum)"
    "         FROM pg_catalog.pg_attribute a JOIN pg_catalog.pg_class c ON c.oid = a.attrelid"
    "         WHERE c.relnamespace = ext.nsoid AND c.relname = 'physicality' AND a.attnum > 0 AND NOT a.attisdropped) = 'entity,tier,hilbert,path,mask'"
    "    AND (SELECT p.partstrat::text || ':' || (SELECT count(*) FROM pg_catalog.pg_inherits i WHERE i.inhparent = c.oid)"
    "         FROM pg_catalog.pg_class c JOIN pg_catalog.pg_partitioned_table p ON p.partrelid = c.oid"
    "         WHERE c.relnamespace = ext.nsoid AND c.relname = 'attestation') = 'r:16'"
    "    AND (SELECT pg_catalog.string_agg(a.attname, ',' ORDER BY a.attnum)"
    "         FROM pg_catalog.pg_attribute a JOIN pg_catalog.pg_class c ON c.oid = a.attrelid"
    "         WHERE c.relnamespace = ext.nsoid AND c.relname = 'attestation' AND a.attnum > 0 AND NOT a.attisdropped) = 'claim,witness,lineage,games,tokens,score,position,trust'"
    "    AND (SELECT p.partstrat::text || ':' || (SELECT count(*) FROM pg_catalog.pg_inherits i WHERE i.inhparent = c.oid)"
    "         FROM pg_catalog.pg_class c JOIN pg_catalog.pg_partitioned_table p ON p.partrelid = c.oid"
    "         WHERE c.relnamespace = ext.nsoid AND c.relname = 'consensus') = 'r:16'"
    "    AND (SELECT pg_catalog.string_agg(a.attname, ',' ORDER BY a.attnum)"
    "         FROM pg_catalog.pg_attribute a JOIN pg_catalog.pg_class c ON c.oid = a.attrelid"
    "         WHERE c.relnamespace = ext.nsoid AND c.relname = 'consensus' AND a.attnum > 0 AND NOT a.attisdropped) = 'claim,rating,deviation,volatility,matches'"
    "  )"
    " FROM pg_catalog.pg_extension e JOIN pg_catalog.pg_namespace n ON n.oid = e.extnamespace,"
    "      LATERAL (SELECT n.oid AS nsoid, n.nspname AS ns) ext"
    " WHERE e.extname = 'laplace'"
    "), false)")
LP_SQL(EXT_MODULE_PATH, 0,
    "WITH paths AS (SELECT p, o FROM pg_catalog.unnest(pg_catalog.string_to_array(pg_catalog.current_setting('extension_control_path'),"
    "  CASE WHEN pg_catalog.current_setting('data_directory') ~ '^[A-Za-z]:' THEN ';' ELSE ':' END)) WITH ORDINALITY AS u(p, o)),"
    " controls AS (SELECT CASE WHEN p = '$system' THEN (SELECT setting FROM pg_catalog.pg_config WHERE name = 'SHAREDIR') ELSE p END"
    "  || '/extension/laplace.control' AS f, o FROM paths)"
    " SELECT pg_catalog.substring(pg_catalog.pg_read_file(f), 'module_pathname\\s*=\\s*''([^'']*)''')"
    " FROM controls WHERE (pg_catalog.pg_stat_file(f, true)).size IS NOT NULL ORDER BY o LIMIT 1")
LP_SQL(RESTORE_FUNCTION_BINDINGS, 0,
    "SELECT @extschema@.laplace_restore_function_bindings()")
LP_SQL(SCHEMA_INDEXES, 0,
    "SELECT @extschema@.laplace_schema_indexes()")
LP_SQL(ANALYZE_SUBSTRATE, 0,
    "ANALYZE @extschema@.entity, @extschema@.physicality, @extschema@.attestation, @extschema@.consensus")
LP_SQL(STATUS_META, 0,
    "SELECT (SELECT extversion FROM pg_catalog.pg_extension WHERE extname = 'laplace'),"
    " @extschema@.laplace_isa(),"
    " pg_catalog.current_setting('laplace.tier0', true),"
    " @extschema@.laplace_fingerprint(),"
    " pg_catalog.pg_size_pretty(pg_catalog.pg_database_size(pg_catalog.current_database())),"
    " pg_catalog.split_part(pg_catalog.version(), ',', 1),"
    " pg_catalog.current_setting('laplace.highway', true),"
    " @extschema@.laplace_highway_fingerprint(),"
    " pg_catalog.current_setting('laplace.chess', true),"
    " @extschema@.laplace_chess_fingerprint()")
LP_SQL(STATUS_TIER_SAMPLE, 0,
    "SELECT tier, estimated FROM @extschema@.laplace_entity_tier_sample() ORDER BY 1")
LP_SQL(STATUS_ENTITY_PHYSICALITY, 0,
    "SELECT CASE WHEN min(c.reltuples) < 0 THEN -1 ELSE sum(c.reltuples) END::bigint,"
    " pg_catalog.pg_size_pretty(sum(pg_catalog.pg_total_relation_size(c.oid))::bigint)"
    " FROM pg_catalog.pg_inherits i"
    " JOIN pg_catalog.pg_class p ON p.oid = i.inhparent"
    " JOIN pg_catalog.pg_class c ON c.oid = i.inhrelid"
    " WHERE p.relnamespace = (SELECT extnamespace FROM pg_catalog.pg_extension WHERE extname = 'laplace')"
    " AND p.relname IN ('entity', 'physicality') AND c.relkind = 'r'")
LP_SQL(STATUS_PARTITIONS, 0,
    "SELECT pg_catalog.regexp_replace(c.relname, '_[0-9a-f]$', ''),"
    " CASE WHEN min(c.reltuples) < 0 THEN -1 ELSE sum(c.reltuples) END::bigint,"
    " pg_catalog.pg_size_pretty(sum(pg_catalog.pg_total_relation_size(c.oid))::bigint)"
    " FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace"
    " WHERE n.oid = (SELECT extnamespace FROM pg_catalog.pg_extension WHERE extname = 'laplace')"
    " AND c.relkind = 'r' AND c.relname ~ '^(attestation|consensus)_[0-9a-f]$' GROUP BY 1 ORDER BY 1")
LP_SQL(STATUS_INDEXES, 0,
    "SELECT count(*) FILTER (WHERE indexdef LIKE '%USING gin%'),"
    " count(*) FILTER (WHERE indexdef LIKE '%USING gist%'),"
    " count(*)::bigint"
    " FROM pg_catalog.pg_indexes"
    " WHERE schemaname = (SELECT n.nspname FROM pg_catalog.pg_namespace n JOIN pg_catalog.pg_extension e ON e.extnamespace = n.oid WHERE e.extname = 'laplace')"
    " AND tablename IN ('entity', 'physicality')")

/* Additional Engine & MCP catalog contracts */
LP_SQL(CONTAINERS_ABOVE, 4,
