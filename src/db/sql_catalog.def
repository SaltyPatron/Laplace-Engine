/* Query, coupling, traversal, forward program */
LP_SQL(FILLS_CLOSURE, 3,
    "SELECT entity, times, tier, level FROM @extschema@.laplace_fills_closure($1::@extschema@.blake3[], $2::bigint[], $3::integer)")
LP_SQL(FORWARD, 2,
    "SELECT i, j, paths, runs, next, times FROM @extschema@.laplace_forward($1::@extschema@.blake3[], $2::bigint)"
    " ORDER BY (i > 1), CASE WHEN i = 1 THEN j END, paths DESC, (j - i) DESC, i, times DESC NULLS LAST")
