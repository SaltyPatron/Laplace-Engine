LP_SQL(COUPLE_SCAN_SCOPED, 7,
    "SELECT entity, occ, route, rating, deviation, volatility, via, rel, tier, distance, vertices"
    " FROM @extschema@.laplace_couple($1::@extschema@.blake3[], $2::bigint, $3::@extschema@.blake3[], $4::smallint, $5::float8, $6::integer, $7::@extschema@.blake3[])"
    " WHERE route = 2")
LP_SQL(FORWARD_TURN_SCOPED, 3,
    "SELECT i, j, paths, next, times FROM @extschema@.laplace_forward($1::@extschema@.blake3[], $2::bigint, $3::@extschema@.blake3[])"
    " ORDER BY j, i, times DESC, next")
LP_SQL(FORWARD_SUFFIX_SCOPED, 3,
