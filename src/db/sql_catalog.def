/* Ingest, staging, diagnostics, maintenance, deployment, benchmarking */
LP_SQL(POOL_SLOTS, 0,
    "SELECT greatest(1, least("
    " pg_catalog.current_setting('max_connections')::int"
    " - pg_catalog.current_setting('superuser_reserved_connections')::int"
    " - pg_catalog.current_setting('reserved_connections')::int"
    " - (SELECT count(*) FROM pg_catalog.pg_stat_activity) - 4,"
    " COALESCE((SELECT CASE WHEN r.rolconnlimit < 0 THEN NULL"
    "  ELSE 1 + greatest(0, r.rolconnlimit - (SELECT count(*) FROM pg_catalog.pg_stat_activity a WHERE a.usesysid = r.oid) - 1) END"
    "  FROM pg_catalog.pg_roles r WHERE r.rolname = current_user), 2147483647)"
    "))::integer,"
    " pg_catalog.to_regprocedure('@extschema@.laplace_stage_own(bigint,regclass[])') IS NOT NULL"
    " AND pg_catalog.to_regprocedure('@extschema@.laplace_accumulate_series(regclass,regclass)') IS NOT NULL"
    " AND pg_catalog.to_regprocedure('@extschema@.laplace_attest_stage(regclass,regclass)') IS NOT NULL"
    " AND pg_catalog.to_regprocedure('@extschema@.laplace_present_stage(regclass,regclass,name,name)') IS NOT NULL,"
    " pg_catalog.to_regprocedure('@extschema@.laplace_merge_stage(regclass,regclass,boolean)') IS NOT NULL"
    " AND pg_catalog.to_regprocedure('@extschema@.laplace_stage_partitions(regclass)') IS NOT NULL"
    " AND pg_catalog.to_regprocedure('@extschema@.laplace_clean_partitions(oid[])') IS NOT NULL")
