LP_SQL(PATH_FIRST, 1,
    "SELECT path FROM @extschema@.laplace_paths($1::@extschema@.blake3[]) LIMIT 1")
LP_SQL(SHAPE_NEAREST_ENTITIES, 2,
    "SELECT id FROM @extschema@.laplace_knn4d(@postgis@.ST_GeomFromEWKB($1::bytea), $2::integer, false, 3::smallint)")
LP_SQL(REPLAY_EXPORT, 1,
    "SELECT claim, trunk, games, tokens, score, \"position\""
    " FROM @extschema@.laplace_replay_export($1::boolean)")
LP_SQL(FORWARD_MCP, 1,
    "SELECT i, j, paths, runs, next, times FROM @extschema@.laplace_forward($1::@extschema@.blake3[], 64) LIMIT 128")
LP_SQL(WITNESS_TRUST_ORDERED, 0,
    "SELECT witness, trust FROM @extschema@.laplace_witness_trust() ORDER BY witness")
LP_SQL(WITNESS_TRUST_ID_ORDERED, 0,
    "SELECT witness FROM @extschema@.laplace_witness_trust() ORDER BY witness")
LP_SQL(MCP_ACTIVITY, 0,
    "SELECT pid, coalesce(usename::text, ''), coalesce(state, ''),"
    " coalesce(extract(epoch FROM now() - query_start)::bigint, 0),"
    " left(regexp_replace(coalesce(query, ''), '\\s+', ' ', 'g'), 200)"
    " FROM pg_catalog.pg_stat_activity"
    " WHERE datname = pg_catalog.current_database() AND pid <> pg_catalog.pg_backend_pid()"
    " AND state IS DISTINCT FROM 'idle' ORDER BY query_start NULLS LAST LIMIT 32")
LP_SQL(MCP_READY, 0,
    "SELECT pg_catalog.current_database(),"
    " coalesce((SELECT extversion FROM pg_catalog.pg_extension WHERE extname = 'laplace'), '')")
LP_SQL(MCP_CATALOG, 0,
    "WITH x AS MATERIALIZED (SELECT @extschema@.laplace_estate_summary(false) AS s)"
    " SELECT pg_catalog.json_build_object('database', x.s->>'database',"
    " 'read_only', (x.s->>'read_only')::boolean,"
    " 'database_bytes', x.s->>'database_bytes',"
    " 'entities', x.s->>'entities',"
    " 'physicalities', x.s->>'physicalities',"
    " 'standing_rows', x.s->>'standing_rows',"
    " 'attestation_rows', x.s->>'attestation_rows',"
    " 'registered_witness_rows', x.s->>'registered_witness_rows',"
    " 'as_of', pg_catalog.statement_timestamp(), 'count_kind', x.s->>'count_kind')::text"
    " FROM x")
LP_SQL(LIBRARY_PAGE, 1,
    "SELECT entity, tier, path, mask::text FROM @extschema@.laplace_library_page($1::@extschema@.blake3, 65)")
LP_SQL(ENTITIES_ORDINAL, 1,
    "SELECT ordinal FROM @extschema@.laplace_entities($1::@extschema@.blake3[])")
LP_SQL(ENTITIES_ORDINAL_HILBERT, 1,
    "SELECT ordinal, hilbert FROM @extschema@.laplace_entities($1::@extschema@.blake3[])")
LP_SQL(ENTITIES_TIER_MASK, 1,
    "SELECT tier, mask FROM @extschema@.laplace_entities($1::@extschema@.blake3[])")
LP_SQL(PHYSICALITIES_BY_ID, 1,
    "SELECT path, tier, mask, mask::text FROM @extschema@.laplace_physicalities($1::@extschema@.blake3[])")

/* Test helpers */
LP_SQL(TEST_ADD, 1, "SELECT $1::integer + 1")
LP_SQL(TEST_ADD2, 1, "SELECT $1::integer + 2")
LP_SQL(TEST_ECHO_IDS, 1, "SELECT $1::@extschema@.blake3[]")
LP_SQL(TEST_BINDING_TYPES, 0,
    "SELECT pg_catalog.to_regtype('@extschema@.blake3')::oid,"
    " pg_catalog.to_regprocedure('@postgis@.st_astext(@postgis@.geometry)') IS NOT NULL")
LP_SQL(TEST_PROBE_COUNT, 1,
    "SELECT count(*)::bigint FROM @extschema@.entity WHERE id OPERATOR(@extschema@.=) $1::@extschema@.blake3")
LP_SQL(TEST_VISIBLE_XACT, 1,
    "SELECT pg_catalog.pg_visible_in_snapshot($1::pg_catalog.xid8, pg_catalog.pg_current_snapshot())")
LP_SQL(TEST_CURRENT_XACT_TEXT, 0,
    "SELECT pg_catalog.pg_current_xact_id()::text")
LP_SQL(TEST_READ_SETTINGS, 0,
    "SELECT pg_catalog.current_setting('transaction_read_only'), pg_catalog.current_setting('transaction_isolation')")
LP_SQL(TEST_FORBIDDEN_DELETE, 0,
    "DELETE FROM @extschema@.entity WHERE false")
LP_SQL(TEST_INSERT_PROBE_ENTITY, 7,
    "INSERT INTO @extschema@.entity(id, tier, coord, hilbert)"
    " VALUES ($1::@extschema@.blake3, $2::smallint, @postgis@.ST_MakePoint($3::float8, $4::float8, $5::float8, $6::float8), $7::bigint)")
LP_SQL(TEST_INSERT_PROBE_PATH, 4,
    "INSERT INTO @extschema@.physicality(entity, tier, hilbert, path)"
    " VALUES ($1::@extschema@.blake3, $2::smallint, $3::bigint, @postgis@.ST_GeomFromEWKB($4::bytea))")
LP_SQL(TEST_MARK_PROBE_CLAIM, 1,
    "UPDATE @extschema@.physicality SET mask = @extschema@.laplace_mask_slot('kind', 'claim')"
    " WHERE entity OPERATOR(@extschema@.=) $1::@extschema@.blake3")
LP_SQL(TEST_INSERT_PROBE_CONSENSUS, 5,
    "INSERT INTO @extschema@.consensus(claim, rating, deviation, volatility, matches)"
    " VALUES ($1::@extschema@.blake3, $2::float8, $3::float8, $4::float8, $5::bigint)")
LP_SQL(TEST_INSERT_READER_NODES, 8,
    "WITH node AS ("
    " SELECT u.id, u.tier, @postgis@.ST_MakePoint(u.x, u.y, u.z, u.m) coord, u.hilbert, @postgis@.ST_GeomFromEWKB(u.ewkb) path"
    " FROM unnest($1::@extschema@.blake3[], $2::smallint[], $3::float8[], $4::float8[], $5::float8[], $6::float8[], $7::bigint[], $8::bytea[])"
    "  AS u(id, tier, x, y, z, m, hilbert, ewkb)"
    "), added AS ("
    " INSERT INTO @extschema@.entity(id, tier, coord, hilbert)"
    " SELECT n.id, n.tier, n.coord, n.hilbert FROM node n"
    " WHERE NOT EXISTS (SELECT 1 FROM @extschema@.entity e WHERE e.id OPERATOR(@extschema@.=) n.id)"
    " RETURNING id"
    "), paths AS ("
    " INSERT INTO @extschema@.physicality(entity, tier, hilbert, path)"
    " SELECT n.id, n.tier, n.hilbert, n.path FROM node n"
    " WHERE n.id OPERATOR(@extschema@.=) ANY(SELECT id FROM added)"
    " RETURNING entity"
    ") SELECT entity FROM paths")
LP_SQL(TEST_UPDATE_PATH_EWKB, 2,
    "UPDATE @extschema@.physicality SET path = @postgis@.ST_GeomFromEWKB($2::bytea)"
    " WHERE entity OPERATOR(@extschema@.=) $1::@extschema@.blake3")
LP_SQL(TEST_DIRECT_ENTITY_EXISTS, 1,
    "SELECT u.ordinal FROM unnest($1::@extschema@.blake3[]) WITH ORDINALITY u(id, ordinal)"
    " WHERE EXISTS (SELECT 1 FROM @extschema@.entity e WHERE e.id OPERATOR(@extschema@.=) u.id)")
LP_SQL(TEST_PLAN_MODE_CUSTOM, 0, "SET plan_cache_mode = force_custom_plan")
LP_SQL(TEST_PLAN_MODE_SHOW, 0, "SHOW plan_cache_mode")
LP_SQL(TEST_PROBE_COMPOSED, 2,
    "SELECT @extschema@.laplace_id($1::text), @extschema@.laplace_id($2::text),"
    " @extschema@.laplace_compose(ARRAY[@extschema@.laplace_id($1::text), @extschema@.laplace_id($2::text)]),"
    " GREATEST(@extschema@.laplace_tier($1::text), @extschema@.laplace_tier($2::text))::smallint + 1::smallint,"
    " @postgis@.ST_X(@extschema@.laplace_coord($1::text)), @postgis@.ST_Y(@extschema@.laplace_coord($1::text)),"
    " @postgis@.ST_Z(@extschema@.laplace_coord($1::text)), @postgis@.ST_M(@extschema@.laplace_coord($1::text)),"
    " @extschema@.laplace_hilbert($1::text),"
    " @postgis@.ST_AsEWKB(@extschema@.laplace_path(ARRAY[@extschema@.laplace_id($1::text), @extschema@.laplace_id($2::text)]))")
LP_SQL(SALIENCE, 2,
