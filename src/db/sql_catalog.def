#ifndef LP_SQL
#error "define LP_SQL(name, arity, sql) before including sql_catalog.def"
#endif

/* Transaction and extension binding lifecycle */
LP_SQL(TX_BEGIN, 0, "BEGIN")
LP_SQL(TX_BEGIN_RC, 0, "BEGIN ISOLATION LEVEL READ COMMITTED")
LP_SQL(TX_BEGIN_RR, 0, "BEGIN ISOLATION LEVEL REPEATABLE READ")
LP_SQL(TX_COMMIT, 0, "COMMIT")
LP_SQL(TX_ROLLBACK, 0, "ROLLBACK")
LP_SQL(EXT_BINDING, 0,
    "SELECT n.nspname, gn.nspname, t.oid, t.typarray"
    " FROM pg_catalog.pg_extension e"
    " JOIN pg_catalog.pg_namespace n ON n.oid = e.extnamespace"
    " JOIN pg_catalog.pg_extension g ON g.extname = 'postgis'"
    " JOIN pg_catalog.pg_namespace gn ON gn.oid = g.extnamespace"
    " JOIN pg_catalog.pg_type t ON t.typnamespace = n.oid AND t.typname = 'blake3'"
    " WHERE e.extname = 'laplace'")

