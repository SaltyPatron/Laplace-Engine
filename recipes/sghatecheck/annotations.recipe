name sghatecheck-annotations
# The README, "/annotations": "This folder contains annotations of selected test cases", and "Human annotation of
# test cases": "up to three bilingual annotators annotated the test cases as hateful if it has harmful language
# directed at a protected group. Other annotation choices are non-hateful and nonsensical".
# The columns' names are the files' own. Each annotator column is an annotator of that file's language, and its field
# what that annotator says of the test case; nothing is written between the two. An annotator stands within the file:
# [the set, the file, the column]. The rest is said of the test case by the set.
match annotations/*_annotations.csv

tier row by \n
header
quoted
tier field by ,

thing row c_testcase
# Some files carry the row numbers of the tables they were written out from ("Unnamed: 0", "Unnamed: 0.1", index):
# how they were written down, not what the set says
omit "Unnamed: 0" "Unnamed: 0.1" index
content c_testcase c_id c_group p_label p_value p_target t_case_local t_function t_gold t_direction t_id annotation_common annotation_selected annotator_*
omit c_order
attest row c_id c_group p_label p_value p_target t_case_local t_function t_gold t_direction t_id c_order annotation_common annotation_selected
voices row annotator_* within-file
