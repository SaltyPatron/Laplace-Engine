name sghatecheck-testcases
# The README, "/testcases": "This folder contains test cases that were generated using the techniques described in
# the paper." It does not describe the columns; their names are the files' own, in the first row:
#   p_label, p_value, p_target, c_testcase, t_case_local, t_function, t_gold, t_direction, t_id
# A test case has no name of its own here: it is the text it is (c_testcase). What a row says of it, it says together.
match testcases/*_testcases_all.csv

tier row by \n
header
quoted
tier field by ,

thing row c_testcase
key row t_id
content c_testcase p_label p_value p_target t_case_local t_function t_gold t_direction
together row
# The README words the parts of a test case only in its figure, "men (placeholder) + I hate {placeholder} (template) =
# I hate men (test case)", and "Placeholders represent the target of each test case"; "SGHateCheck inherits 30
# functionalities from HateCheck". t_function, t_gold, t_direction and p_label (the placeholder as the template writes
# it, {IDENTITY_P}) are labels the set gives the case: values of its own vocabularies.
value - p_label t_function t_gold t_direction
relation "placeholder" p_value
relation "template" t_case_local
relation "the target of each test case" p_target
attest row p_label p_value p_target t_case_local t_function t_gold t_direction
