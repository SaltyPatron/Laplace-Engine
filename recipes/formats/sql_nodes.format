# Shared SQL declarations and references for psql containers and embedded SQL.
resolve sql
quotes Sconst NonReservedWord_or_Sconst string_literal escape_string_literal dollar_quoted_string
node CreateStmt group as create_table capture source
node CreateFunctionStmt group as create_function capture source
node CreateFunctionStmt group as create_procedure capture source when kw_procedure is PROCEDURE casefold
node ViewStmt group as create_view capture source
node CreateDomainStmt group as create_type capture source
node DefineStmt group as create_type capture source when kw_type is TYPE casefold
node qualified_name text field name under CreateStmt as name
node qualified_name text under ViewStmt as name
node func_name text under CreateFunctionStmt as name
node any_name text under CreateDomainStmt as name
node any_name text under DefineStmt as name
node func_args_with_defaults text as parameters
node OptTableElementList text as members_source
node Sconst text under func_as as implementation grammar plpgsql when ^CreateFunctionStmt//language is plpgsql casefold required
node Sconst text under func_as as implementation grammar sql_body when ^CreateFunctionStmt//language is sql casefold required
node Sconst text under func_as as implementation
node Sconst text under dostmt_opt_item as implementation grammar plpgsql when ^DoStmt//language missing required
node Sconst text under dostmt_opt_item as implementation grammar plpgsql when ^DoStmt//language is plpgsql casefold required
node qualified_name group as reference capture referenced_identifier
node func_name group as reference capture referenced_identifier
node columnref group as reference capture referenced_identifier
node ColId group as reference capture referenced_identifier
