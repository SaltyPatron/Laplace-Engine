# Complete declaration bytes accompany the extracted semantic fields.
grammar python
records children
node @record group as packaging capture source
node function_definition group as function_definition capture source
node class_definition group as class_definition capture source
node identifier text field name as name
node parameters text as parameters
node block group under function_definition as implementation capture implementation_source


# Declaration-name rules are more specific; remaining names are references.
node identifier group as reference capture referenced_identifier
