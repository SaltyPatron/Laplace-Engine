# Inner separator symbols are selected by compiled part instructions.
grammar lp_parts
separator slash /
separator pipe |
separator comma ,
separator semicolon ;
separator colon :
separator equals =
separator percent %
separator greater >
separator hyphen -
separator dot .
separator star *
separator spacing space
separator tab \t
separator newline \n
node document group list
node text text raw
node slash text raw kind
node pipe text raw kind
node comma text raw kind
node semicolon text raw kind
node colon text raw kind
node equals text raw kind
node percent text raw kind
node greater text raw kind
node hyphen text raw kind
node dot text raw kind
node star text raw kind
node spacing text raw kind
node tab text raw kind
node newline text raw kind
