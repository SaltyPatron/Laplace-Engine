# Complete declaration bytes accompany the extracted semantic fields.
grammar typescript
records children
node @record group as packaging capture source
node function_declaration group as function_declaration capture source
node class_declaration group as class_declaration capture source
node method_definition group as method_definition capture source
node identifier text field name as name
node property_identifier text field name as name
node type_identifier text field name as name
node formal_parameters text as parameters
node statement_block group as implementation capture implementation_source


# Declaration-name rules are more specific; remaining names are references.
node identifier group as reference capture referenced_identifier
