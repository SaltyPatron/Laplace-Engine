name geonames-geoname
# The 'geoname' table. readme.txt:
#   "The data format is tab-delimited text in utf8 encoding."
#   "geonameid         : integer id of record in geonames database"
#   "name              : name of geographical point (utf8) varchar(200)"
#   "asciiname         : name of geographical point in plain ascii characters, varchar(200)"
#   "alternatenames    : alternatenames, comma separated, ascii names automatically transliterated, ..."
#   "latitude          : latitude in decimal degrees (wgs84)"
#   "longitude         : longitude in decimal degrees (wgs84)"
#   "feature class", "feature code", "country code", "cc2" (comma separated), "admin1 code" .. "admin4 code",
#   "population", "elevation", "dem", "timezone", "modification date : date of last modification in yyyy-MM-dd format"
# The geonameid is the key the other files point at a place with. A place is its name, latitude and longitude
# together; the row says the rest of it. The modification date is GeoNames's bookkeeping.
match allCountries.txt

tier row by \n
names geonameid name asciiname alternatenames latitude longitude "feature class" "feature code" "country code" cc2 "admin1 code" "admin2 code" "admin3 code" "admin4 code" population elevation dem timezone "modification date"
tier field by \t
part alternatenames by ,
part cc2 by ,

thing row name latitude longitude
key row geonameid
content name latitude longitude asciiname "feature class" "feature code" "country code" cc2 "admin1 code" "admin2 code" "admin3 code" "admin4 code" population elevation dem timezone
# readme.txt: "the field 'alternatenames' in the table 'geoname' is a short version of the 'alternatenames' table
# without links and postal codes but with ascii transliterations." The alternate-names file says each name with its
# language, so this copy is read by nothing.
omit "modification date" alternatenames
#   "asciiname         : name of geographical point in plain ascii characters, varchar(200)"
relation "name of geographical point in plain ascii characters" asciiname
# The feature class and code are values of GeoNames's own lists ("feature class     : see
# http://www.geonames.org/export/codes.html, char(1)"; "feature classes: A: country, state, region,... H: stream,
# lake, ..."), which featureCodes_*.txt names and describes.
value - "feature class" "feature code"
#   "country code      : ISO-3166 2-letter country code, 2 characters"
#   "cc2               : alternate country codes, comma separated, ISO-3166 2-letter country code, 200 characters"
relation "ISO-3166 2-letter country code" "country code"
relation "alternate country codes" cc2
#   "dem               : digital elevation model, srtm3 or gtopo30, average elevation of 3''x3'' (ca 90mx90m) or 30''x30'' (ca 900mx900m) area in meters, integer."
relation "digital elevation model" dem
#   "timezone          : the iana timezone id (see file timeZone.txt) varchar(40)"
relation "the iana timezone id" timezone
# The admin codes are GeoNames's pointers to the administrative divisions ("admin1 code : fipscode ..., see file
# admin1Codes.txt for display names of this code"; "The corresponding admin feature is found with the same
# countrycode and adminX codes and the respective feature code ADMx"): a code is a key only together with the country
# code and the codes above it, so resolving it to the division it points at is Laplace-Engine#20, and each stays an
# obligation until then.
# The readme words population ("bigint (8 byte int)") and elevation ("in meters, integer") only by their type and
# unit, no relation: each stays an obligation until a documented wording is found (Laplace-Engine#32).
attest row asciiname "feature class" "feature code" "country code" cc2 "admin1 code" "admin2 code" "admin3 code" "admin4 code" population elevation dem timezone
