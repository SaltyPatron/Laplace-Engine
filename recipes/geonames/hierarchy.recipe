name geonames-hierarchy
# readme.txt:
#   "hierarchy.zip		: parentId, childId, type. The type 'ADM' stands for the admin hierarchy modeled by the admin1-4 codes."
# Both ids are keys of the geoname table's rows: each is read as the place it points at. What a row says of its
# parent (the child, and the type) it says together.
match hierarchy.txt

tier row by \n
names parentId childId type
tier field by \t

thing row parentId
refer parentId geonames-geoname
refer childId geonames-geoname
content type
together row
attest row childId type
