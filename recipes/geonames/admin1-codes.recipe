name geonames-admin1-codes
# readme.txt:
#   "admin1CodesASCII.txt     : names in English for admin divisions. Columns: code, name, name ascii, geonameid"
match admin1CodesASCII.txt
grammar table
columns code name "name ascii" geonameid
# the geonameid is read as the place; the code (US.CA) is GeoNames's key to the division, recorded nowhere
key code
refer geonameid geonames-geoname

claims
subject in geonameid
attest name "name ascii"
