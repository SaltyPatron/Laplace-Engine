name wikidata-entities
# Wikidata JSONL entities: one JSON object per line.
# id is the shared Q... / P... / L... highway identifier; mainsnak statements compose [property, datavalue];
# multilingual labels/descriptions/aliases (carrying language + value) and sitelinks (site + title) attach
# directly onto the entity. Statement GUIDs (containing '$') and MediaWiki revision mirrors are omitted.
match *.jsonl *.json
format json
tier record by \n

thing record id
thing mainsnak property datavalue/value/id
thing mainsnak property datavalue/value/text
thing mainsnak property datavalue/value/time
thing mainsnak property datavalue/value/amount
thing mainsnak property datavalue/value

empty []
# Omit internal dump revision counters, redundant numeric IDs, and statement GUIDs (containing '$').
omit pageid ns lastrevid modified hash numeric-id statements badges entity-type datatype
when id matches [$]
omit id
always
content *

value - type rank snaktype
relation "Wikidata statement" mainsnak
attest record type
when snaktype is value
when rank is-not deprecated
holds record mainsnak
always
when rank is deprecated
relation "deprecated Wikidata statement" mainsnak
holds record mainsnak
always
when snaktype is novalue
relation "Wikidata novalue statement" mainsnak
holds record mainsnak
always

when language matches .
relation "lexicalization or description" value
attest * value
always

when site matches .
relation "Wikimedia site" site
relation "Wikimedia sitelink title" title
attest * site title
always
