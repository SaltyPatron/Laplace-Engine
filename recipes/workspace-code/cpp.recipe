# Tree-sitter declaration kinds and complete declaration bytes are content, not relation verbs.
name workspace-cpp
match *.cpp *.cc *.cxx *.c++ *.hpp *.hh *.hxx *.inl *.ipp
format code_cpp
content source name referenced_identifier implementation_source parameters parameters_source implementation signature_source members_source
thing packaging source
thing function_definition literal function_definition source
thing struct_specifier literal struct_specifier source
thing class_specifier literal class_specifier source
thing parameters parameters_source
relation "declared identifier" name
relation "parameter signature" parameters
relation "implemented by" implementation
relation "declaration signature" signature.signature_source
relation "declared identifier" signature.name
relation "parameter signature" signature.parameters
relation "parameter signature" signature.parameters.parameters_source
relation "declared members" members.members_source
relation "declared identifier" members.name
relation "declared members" members_source
attest function_definition name parameters signature members members_source
attest struct_specifier name parameters signature members members_source
attest class_specifier name parameters signature members members_source

thing parameter_declaration literal parameter_declaration source
attest parameter_declaration name
attest signature parameters
relation "referenced identifier" reference
attest reference .
# A body is attested as its captured surface; nested reference groups speak separately.
attest implementation .
