# Tree-sitter declaration kinds and complete declaration bytes are content, not relation verbs.
name workspace-sql
match *.sql
format code_sql
content source name parameters implementation signature_source members_source
thing packaging source
thing create_table literal create_table source
thing create_function literal create_function source
thing create_procedure literal create_procedure source
thing create_view literal create_view source
thing create_type literal create_type source
relation "declared identifier" name
relation "parameter signature" parameters
relation "implemented by" implementation
relation "declaration signature" signature.signature_source
relation "declared identifier" signature.name
relation "parameter signature" signature.parameters
relation "declared members" members.members_source
relation "declared identifier" members.name
relation "declared members" members_source
attest create_table name parameters implementation signature members members_source
attest create_function name parameters implementation signature members members_source
attest create_procedure name parameters implementation signature members members_source
attest create_view name parameters implementation signature members members_source
attest create_type name parameters implementation signature members members_source

