name plain
# The repositories' files that no grammar reads and are text: templates (*.in), the Engine's recipes
# and formats and the files naming its sources and their order, Windows command scripts, test outputs, systemd units,
# patches, example configurations, licences, the PostgreSQL extension control and install files, and task files.
match *.in *.recipe *.format *.firmware *.cmd *.bat *.out *.service *.timer *.patch *.example *.scm *.path source order LICENSE Justfile *.def *.control *.install *.upgrade *.list *.hujson
class UserCuratedResource
grammar text
