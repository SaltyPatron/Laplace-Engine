name workspace-code
# The Laplace repositories, as the workspace README names them ("Laplace Workspace"): every file each repository
# keeps, read by its language's grammar or as text. What a repository's .gitignore files say is not the repository is
# not read, and neither is anything under a hidden directory (.git).
witness Laplace Workspace
called Laplace Workspace
class UserCuratedResource
root $LAPLACE_SRC
files $LAPLACE_SRC/Laplace
files $LAPLACE_SRC/Laplace-Native
files $LAPLACE_SRC/Laplace-postgres
files $LAPLACE_SRC/Laplace-Engine
files $LAPLACE_SRC/Laplace-Prototype
files $LAPLACE_SRC/Laplace-MCP
files $LAPLACE_SRC/Laplace-UCI
files $LAPLACE_SRC/Laplace-Operations
files $LAPLACE_SRC/Laplace-Wiki
files $LAPLACE_SRC/Laplace-Conventional
ignore .gitignore
# a working tree: each whole reading is what the workspace says now, and supersedes the readings before it, so a file
# changed or removed since leaves nothing of its former content that only those readings held
supersede
# Text leaves and code identities come from the installed perf-caches; no
# Unicode corpus ingestion is needed to read the workspace's declarations.
reads text json xml cuda javascript tsx bash powershell css html cmake make dockerfile rust go java ruby
