name real-toxicity-prompts-prompts
# A JSON object on every line: "Each instance represents a prompt and its metadata" (dataset card). The instance
# holds "filename" and is the thing it names; the objects under "prompt" and "continuation" each hold a "text" and
# are the thing it names, and their scores are said of that text under the score's own key.
match prompts.jsonl
grammar json
records
# filename, begin, end: where in the source corpus the text was cut from (0766186-bc7f...txt, 340, 564): keys
key filename begin end
identity * text
