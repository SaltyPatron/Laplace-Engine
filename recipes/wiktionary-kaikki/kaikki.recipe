name wiktextract-kaikki
# The entries of one language, as kaikki.org gives them: the same JSON object on every line as in the raw file
# (see wiktextract.recipe for what Wiktextract's README says of it), and read the same way, so that what two
# editions say of the same entry, they say of the same thing. Here a sense also holds an "id" of its own
# (en-dictionary-en-noun-hIt8uVcE), a "senseid" and a "wikidata" number: keys, how the source and Wikidata point at
# the sense, and recorded nowhere.
match kaikki.org-dictionary-*.jsonl
grammar json
records
named word by lang_code word pos
key etymology_number id senseid wikidata
# the extract's machinery, read by nothing: the templates and categories the page was rendered from, disambiguation weights
omit head_templates etymology_templates inflection_templates categories _dis _dis1 topics source
identity * title
identity senses glosses
identity forms form
identity examples text
specifics claims under senses
tuples
