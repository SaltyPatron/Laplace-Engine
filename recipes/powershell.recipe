name powershell
# Source code as its syntax tree, by the tree-sitter grammar powershell ($LAPLACE_GRAMMARS, built from $LAPLACE_GRAMMAR_SRC by
# tools/build_grammars.sh): each node the composition of its children with the bytes between them, so the file
# recomposes byte for byte; leaves are text.
match *.ps1 *.psm1 *.psd1
class UserCuratedResource
grammar powershell
