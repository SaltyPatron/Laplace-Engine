name cldr-supplemental-data
# CLDR's supplemental data. The elements that name one thing by one attribute are read: each says of that thing what
# its other attributes hold, under the attribute's own name, and what the elements inside it say (a territory's
# languagePopulation, a region's currency, a calendar's calendarSystem and era) is said of it, each such element
# together as one record.
# "Copyright © 1991-2026 Unicode, Inc." and "CLDR data files are interpreted according to the LDML specification"
match supplementalData.xml
witness CLDR
format xml

thing language type
thing territory type
thing group type
thing region iso3166
thing info iso4217
thing territoryCodes type
thing currencyCodes type
thing calendar type
thing scriptVariant id
thing parentLocale parent
thing reference type
omit xmlns xmlns:*
content *

attest language *
attest territory *
attest group *
attest region *
attest info *
attest territoryCodes *
attest currencyCodes *
attest calendar *
attest scriptVariant *
attest parentLocale *
attest reference * .
attest languagePopulation *
together languagePopulation
attest currency *
together currency
attest calendarSystem *
attest era *
together era
