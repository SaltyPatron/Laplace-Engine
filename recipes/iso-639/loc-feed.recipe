name loc-feed
# The Library of Congress's Atom feed of changes to ISO 639-5. The feed and each entry are the thing their id names.
# Each element inside one says of it, under its own name, its text; a link says of it the resource it points at,
# under the link's rel; the author's name and email, the category's term, and the change described in the entry's
# content are said of it. The dates are when the Library of Congress published the change.
match iso639-5.atom10.xml
witness Library of Congress
format xml

thing feed id
thing entry id
omit xmlns xmlns:* xml:lang length
content *
attest feed */
attest entry */
relate link rel to href
attest link title type
attest author */
attest category term
attest div class
attest p .
