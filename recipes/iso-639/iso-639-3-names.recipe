name iso-639-3-names
# ISO 639-3's name index: the names each identifier is printed and inverted under. SIL's
# iso639-3_names_table_definition.txt:
#   "Print_Name     varchar(75) NOT NULL,  -- One of the names associated with this identifier"
#   "Inverted_Name  varchar(75) NOT NULL)  -- The inverted form of this Print_Name form"
match iso-639-3_Name_Index.tab
witness SIL Global

tier row by \n
header
tier field by \t

thing row Id
content Id Print_Name Inverted_Name
relation "One of the names associated with this identifier" Print_Name
relation "The inverted form of this Print_Name form" Inverted_Name
attest row Print_Name Inverted_Name
