name iso-639-3-retirements
# ISO 639-3's retired identifiers: what each was, and what it changed to.
match iso-639-3_Retirements.tab
grammar table
header

claims
predicate Reference Name
subject in Id
object in Ref_Name

claims
predicate Change To
subject in Id
object in Change_To

claims
predicate Retirement Remedy
subject in Id
object in Ret_Remedy

claims
predicate Effective
subject in Id
object in Effective
