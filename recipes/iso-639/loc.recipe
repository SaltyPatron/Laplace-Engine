name loc-iso639
# The Library of Congress's ISO 639 lists as RDF/XML (MADS/RDF). An element that names a resource (rdf:about) is the
# thing its URI names. Each element inside it says of it, under the element's own name, its text, or the resource
# it points at (rdf:resource), or the thing written inside it. An element's attributes other than rdf:about are said
# of the thing the element is.
# rdf:parseType="Literal" elements hold XHTML, a page and not a value: they are in the file's tree and attest nothing.
match iso639-?.rdf
witness Library of Congress
format xml

thing * rdf:about
omit xmlns xmlns:* rdf:datatype lclang xml:lang rdf:parseType
content *
attest * */
holds * * via
