name iana-language-subtag-registry
# The IANA language subtag registry (RFC 5646, 3.1): records of fields, parted by a line "%%"; each field written
# "Field-Name: value", a line that begins with white space continuing the one before. A record is about its Subtag, or
# its Tag (a grandfathered or redundant tag has a Tag and no Subtag); every other field is said of it, under the
# field's own name. The first record holds only the File-Date: it is said of the file, in its metadata.
# The file does not name who publishes it; the directory it is kept in is named iana.
match language-subtag-registry.txt
witness {dir}

tier record by \n%%\n
tier field by \n
is :
continued

thing record Subtag
thing record Tag
metadata File-Date
content *
attest record *
