name iana-language-subtag-registry
# The IANA language subtag registry: records of fields. Every field is said of the record's subtag or tag, under the
# field's own name.
match language-subtag-registry.txt
grammar fields
record %%
field :
about Subtag Tag
# The file does not name who publishes it; the directory it is kept in is named iana.
witness {dir}
