name wordnet-sents
# wndb.5, "Verb Example Sentences": "The file sents.vrb lists all of the example sentence templates. Each line begins
# with the template number followed by a space. The rest of the line is the text of a template example sentence,
# with %s used as a placeholder in the text for the verb" ("1 The children %s to the playground").
# The highway template is its identifier number; WordNet attests its text as
# the example sentence template referred to by sentidx.vrb.
match sents.vrb
format wndb

tier line by \n
names number text
tier field by space

type number wnsentence node
thing line number
content text
relation "example sentence template" text
attest line text
types wnsentence "WordNet verb example sentence template" line
keyed wnsentence line number
keyed wnsentence line text
