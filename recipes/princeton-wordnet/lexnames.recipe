name wordnet-lexnames
# lexnames(5), "File Format": "Each line in lexnames contains 3 tab separated fields ... The first field is the two
# digit decimal integer file number. ... The second field is the name of the lexicographer file that is represented by
# that number, and the third field is an integer that indicates the syntactic category of the synsets contained in the
# file." The fields are named as the page names them: "file number", "lexicographer file", "syntactic category".
# A lexicographer file is its name (noun.animal): the types the highway lists as WordNet's lexicographer files, by
# their names and by their numbers, which are WordNet's keys of them (a synset's lex_filenum). The syntactic category
# (1 a noun, 2 a verb, 3 an adjective, 4 an adverb) is said of the file.
match lexnames

tier line by \n
names "file number" "lexicographer file" "syntactic category"
padded
tier field by \t

thing line "lexicographer file"
key line "file number"
content "lexicographer file" "syntactic category"
# lexnames.5: "the third field is an integer that indicates the syntactic category of the synsets contained in the
# file", "encoded as follows: 1 NOUN 2 VERB 3 ADJECTIVE 4 ADVERB": a value of WordNet's syntactic categories as
# written, said of the lexicographer file ([noun.event, 1])
value - "syntactic category"
attest line "syntactic category"

types lexfile "WordNet lexicographer file" line
keyed lexfile line "lexicographer file"
keyed lexfile line "file number"
