name wordnet-index
# The index files, one for each syntactic category (wndb.5WN, "Index File Format"): after the license lines, which
# begin with two spaces, "Each index file begins with several lines containing a copyright notice ... Each line
# contains the following:
#   lemma  pos  synset_cnt  p_cnt  [ptr_symbol...]  sense_cnt  tagsense_cnt   synset_offset  [synset_offset...]"
# "p_cnt: Number of different pointers that lemma has in all synsets containing it"; the field names are wndb.5's,
# this recipe's handles, in no claim.
match index.noun index.verb index.adj index.adv
format wndb

tier line by \n
comment space
names lemma pos synset_cnt p_cnt sense_cnt tagsense_cnt synset_offset...
counted p_cnt pointer ptr_symbol
tier field by space

# "lemma: lower case ASCII text of word or collocation. Collocations are formed by joining individual words with an
# underscore (_) character": the word, content, written with its spaces
thing line lemma
part lemma by \t space _
content lemma
# "pos: Syntactic category: n for noun files, v for verb files, a for adjective files, r for adverb files": a value of
# WordNet's syntactic categories (the highway's wordnet-pos tagset), with the source spelling retained beside the UPOS
# its crosswalk edge reaches
type pos upos crosswalk wordnet-pos
value upos pos
attest line pos
# "synset_offset: Byte offset in data.pos file of a synset containing lemma": WordNet's pointer to the synset, which
# CILI keys as the offset and the letter of its type; an adjective's satellite is written a here and s in CILI. The
# concept, resolved through the highway, recorded nowhere as an offset.
type synset_offset ili as \0-{pos} as \0-s
relation "synset containing lemma" synset_offset
attest line synset_offset
# "ptr_symbol: A space separated list of p_cnt different types of pointers that lemma has in all synsets containing
# it": each as WordNet writes it (@, ~, !, ...), which is the file's markup. The relation is what wninput.5WN says the
# symbol is (hypernym, hyponym, member meronym, ...), said of the lemma the line is, in its own group (counted p_cnt).
# An adverb's backslash is "Derived from adjective", an adjective's "Pertainym".
when ^line/pos is r
type ptr_symbol wnpointer vocabulary wordnet-pointer-adverb node
always
when ^line/pos is-not r
type ptr_symbol wnpointer vocabulary wordnet-pointer node
always
pair pointer ptr_symbol
# synset_cnt and p_cnt count what follows; sense_cnt: "Same as sync_cnt above. This is redundant, but the field was
# preserved for compatibility reasons": the file's layout, read by nothing. tagsense_cnt, "Number of senses of lemma that
# are ranked according to their frequency of occurrence in semantic concordance texts", is a count the semantic
# concordance measures (the tag counts are cntlist's, and become the attestation's games): it is no claim's value.
omit synset_cnt p_cnt sense_cnt tagsense_cnt
