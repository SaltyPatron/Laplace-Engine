name wordnet-frames
# wndb.5: a verb synset's frames are "a list of numbers corresponding to the generic verb sentence frames for words in
# the synset"; "f_num is a two digit decimal integer frame number", and "See wninput(5WN) for the text of the generic
# sentence frames". frames.vrb, and verb.Framestext beside it (the same lines), write each frame on a line: its number,
# then its text ("1  Something ----s").
# A frame is its text; the highway lists the frames as WordNet's generic verb sentence frames, by their numbers (the
# keys data.verb's f_num writes them by) and by their texts.
match frames.vrb verb.Framestext

tier line by \n
names frame
tier field by \t
part frame by space pieces 2 padded

thing line frame/2
types wnframe "WordNet generic verb sentence frame" line
keyed wnframe line frame/1
keyed wnframe line frame/2
