name wordnet-adverb-exceptions
# wndb.5: adv.exc lists inflected adverbs and their base forms.
match adv.exc
format wndb
tier row by \n
names inflected lemma...
tier field by space
thing row inflected literal ADV
itself row
part inflected by \t space _
part lemma by \t space _
content inflected lemma
relation "base form" lemma
attest row lemma
