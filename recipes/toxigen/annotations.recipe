name toxigen-annotations
# The raw annotations, written out from Parquet as a table whose first row names its columns. A row is one hashed
# worker's reading of one text: what the set says of the text (Input.*) it says; what the worker answered of the text
# (Answer.*) the worker says; what the row holds of the worker (Answer.annotator*) is said of the worker.
# HashedWorkerId is content beside the judgment; ToxiGen is the sole witness.
# The card lists the columns and words none; the questions are the paper's (Figure 6, see annotated.recipe), and
# Input.prompt, Input.generation_method and the prompt's label are the generations' fields the card words (see
# generations.recipe).
match annotations/train-*.tsv

tier row by \n
header
escaped \
tier field by \t

thing row Input.text
omit Input.time
content HashedWorkerId
content Input.* Answer.*
score row Input.binary_prompt_label from 0 to 1
default Answer.writer.1 false
default Answer.writer.2 false
default Answer.toPER.1 false
default Answer.toPER.2 false
default Answer.toPER.3 false
default Answer.toPER.4 false
default Answer.toPER.5 false
default Answer.toAI.1 false
default Answer.toAI.2 false
default Answer.toAI.3 false
default Answer.toAI.4 false
default Answer.toAI.5 false
default Answer.intent.1 false
default Answer.intent.2 false
default Answer.intent.3 false
default Answer.intent.4 false
default Answer.intent.5 false
default Answer.lewd.1 false
default Answer.lewd.2 false
default Answer.lewd.3 false
default Answer.stereo.1 false
default Answer.stereo.2 false
default Answer.stereo.3 false
default Answer.inGroup.on false
default Answer.ingroup.1 false
default Answer.ingroup.2 false
default Answer.ingroup.3 false
default Answer.annotatorPolitics.1 false
default Answer.annotatorPolitics.2 false
default Answer.annotatorPolitics.3 false
default Answer.annotatorPolitics.4 false
default Answer.annotatorPolitics.5 false
# "**prompt** is the prompt used for **generation**."
relation "the prompt used for generation" Input.prompt
# "Targeted Group: Black folks" (the annotation setup)
relation "Targeted Group" Input.target_group
# "**prompt_label** is the binary value indicating whether or not the prompt is toxic (1 is toxic, 0 is benign)."
relation "whether or not the prompt is toxic" Input.binary_prompt_label
# How the text was generated (TopK, CBS, ...) and the prompt's label (hate, neutral): values of the set's vocabularies.
value - Input.generation_method Input.prompt_label
# The answers the worker picked from a list, each to its question (framingQ and refTarget both answer "other"):
#   "9) In your opinion, does the text explicitly claim to be factual?"
relation "does the text explicitly claim to be factual?" Answer.factSelect
#   "8) In your opinion, how does the text refer to the targeted individual/group?"
relation "how does the text refer to the targeted individual/group?" Answer.framingQ
#   "7) In your opinion, does the text refer to the given targeted group?"
relation "does the text refer to the given targeted group?" Answer.refTarget
# "If you selected "Other," please provide a single sentence explaining how the individual/group is being targeted"
relation "explaining how the individual/group is being targeted" Answer.stateFrame
# "If the text refers directly/indirectly to one or more other groups, please list them below"
relation "refers directly/indirectly to one or more other groups" Answer.stateGroup
# Worker form one-hot checkbox options (default false suppressed so only selected choices are attested):
relation "Do you think the text is human-written?" Answer.writer.1
relation "Do you think the text is machine-generated?" Answer.writer.2
relation "harmful if person wrote it (1 = benign)" Answer.toPER.1
relation "harmful if person wrote it (2 = slightly benign)" Answer.toPER.2
relation "harmful if person wrote it (3 = neutral)" Answer.toPER.3
relation "harmful if person wrote it (4 = somewhat offensive)" Answer.toPER.4
relation "harmful if person wrote it (5 = clearly offensive)" Answer.toPER.5
relation "harmful if AI wrote it (1 = benign)" Answer.toAI.1
relation "harmful if AI wrote it (2 = slightly benign)" Answer.toAI.2
relation "harmful if AI wrote it (3 = neutral)" Answer.toAI.3
relation "harmful if AI wrote it (4 = somewhat offensive)" Answer.toAI.4
relation "harmful if AI wrote it (5 = clearly offensive)" Answer.toAI.5
relation "intentionally written to be harmful (1 = no)" Answer.intent.1
relation "intentionally written to be harmful (2 = unlikely)" Answer.intent.2
relation "intentionally written to be harmful (3 = unclear)" Answer.intent.3
relation "intentionally written to be harmful (4 = likely)" Answer.intent.4
relation "intentionally written to be harmful (5 = yes)" Answer.intent.5
relation "sexual content choice: contains sexual content" Answer.lewd.1
relation "sexual content choice: might contain sexual content" Answer.lewd.2
relation "sexual content choice: no sexual content" Answer.lewd.3
relation "positive stereotyping choice: expresses it" Answer.stereo.1
relation "positive stereotyping choice: maybe expresses it" Answer.stereo.2
relation "positive stereotyping choice: does not express it" Answer.stereo.3
relation "uses in-group language" Answer.inGroup.on
relation "in-group effect choice: harmful even if in-group" Answer.ingroup.1
relation "in-group effect choice: maybe less harmful in-group" Answer.ingroup.2
relation "in-group effect choice: harmless as in-group" Answer.ingroup.3
# Worker self-reported attributes:
relation "self-reported worker age" Answer.annotatorAge
relation "self-reported worker gender" Answer.annotatorGender
relation "self-reported worker minority status" Answer.annotatorMinority
relation "self-reported worker race" Answer.annotatorRace
relation "self-reported political stance choice 1" Answer.annotatorPolitics.1
relation "self-reported political stance choice 2" Answer.annotatorPolitics.2
relation "self-reported political stance choice 3" Answer.annotatorPolitics.3
relation "self-reported political stance choice 4" Answer.annotatorPolitics.4
relation "self-reported political stance choice 5" Answer.annotatorPolitics.5
attest row Input.prompt Input.generation_method Input.prompt_label Input.target_group Input.binary_prompt_label
attest row Answer.factSelect Answer.framingQ Answer.inGroup* Answer.ingroup* Answer.intent* Answer.lewd* Answer.refTarget Answer.stateFrame Answer.stateGroup Answer.stereo* Answer.toAI* Answer.toPER* Answer.writer* with HashedWorkerId
attest row Answer.annotator* of HashedWorkerId
# Input.binary_prompt_label scores each row on [0, 1] (0 = benign prompt, 1 = toxic prompt); Input.time is omitted as
# HIT timing bookkeeping, and boolean checkboxes suppress default false entries.
