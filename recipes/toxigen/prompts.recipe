name toxigen-prompts
# The prompts, one file for each kind (hate_asian_1k, neutral_black_1k, ...), written out from Parquet as a table
# whose first row names its column. What the file's name says up to its first hyphen is said of each text in it,
# nothing written between the two.
match prompts/*.tsv

tier row by \n
header
escaped \
tier field by \t

stem -
thing row text
content text
pair row {file}
