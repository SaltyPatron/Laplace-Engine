name toxigen-annotated
# The annotated statements, one on every row; the first row names the columns (the dataset card lists the same
# names under config_name: annotated) and each is said of the text under that name. annotated_train.csv writes its
# texts as b'...' and they are recorded as written. predicted_group is sometimes written as a list between square
# brackets, which nothing reads: it is recorded as written, whole.
# A field written with a doubled double quote is left unread rather than recorded with the doubling.
match annotated_train.csv
grammar csv

claims
predicate target_group
query
(row . (field) @subject.text . (field) @object.text (#not-eq? @subject.text "text") (#not-match? @subject.text "\"\"") (#not-match? @object.text "\"\""))
end

claims
predicate factual?
query
(row . (field) @subject.text . (field) . (field) @object.text (#not-eq? @subject.text "text") (#not-match? @subject.text "\"\"") (#not-match? @object.text "\"\""))
end

