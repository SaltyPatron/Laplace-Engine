name toxigen-generations
# The generations, written out from Parquet as a table whose first row names its columns. Of a generation the row says
# its prompt, how it was generated and the classifier's prediction; of the prompt, its label and group. Each said
# together.
match train/train-*.tsv

tier row by \n
header
escaped \
tier field by \t

thing row generation
content *
together row
attest row prompt generation_method roberta_prediction
attest row prompt_label group of prompt
