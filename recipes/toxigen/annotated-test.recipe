name toxigen-annotated-test
# The annotated statements of the test split: as annotated_train.csv, without the column label.
# A field written with a doubled double quote is left unread rather than recorded with the doubling.
match annotated_test.csv
grammar csv

claims
predicate target_group
query
(row . (field) @subject.text . (field) @object.text (#not-eq? @subject.text "text") (#not-match? @subject.text "\"\"") (#not-match? @object.text "\"\""))
end

claims
predicate factual?
query
(row . (field) @subject.text . (field) . (field) @object.text (#not-eq? @subject.text "text") (#not-match? @subject.text "\"\"") (#not-match? @object.text "\"\""))
end

