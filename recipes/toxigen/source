name toxigen
# ToxiGen: machine-generated statements about groups, with labels. The dataset card's title: "Dataset Card for
# ToxiGen"; pretty_name: ToxiGen.
witness ToxiGen
class AcademicCurated
root $LAPLACE_DATA/Safety/ToxiGen/toxigen-*[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]
# The set comes as HF Parquet splits under train/, prompts/, annotated/, annotations/, plus CSV mirrors and extracted/ TSVs.
# Skip CSV mirrors and pre-extracted TSVs so the canonical Parquet splits are read once; read README/cards as text.
except *.csv */extracted/*
after unicode iso-639
reads text
