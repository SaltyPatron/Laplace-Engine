name cili-map-pwn31
# Princeton WordNet 3.1 renumbered its files. The same offset can refer to a
# different ILI in 3.0, so these pointers have their own lookup namespace.
match ili-map-pwn31.tab

tier row by \n
names ili offset
tier field by \t

thing row ili
content ili
types ili "Interlingual index concept" row
keyed ili row ili
keyed wordnet-3.1 row offset
