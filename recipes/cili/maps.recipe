name cili-maps
# The index's maps to the wordnets, as tables: a concept, and the synset it is in the wordnet the file's name gives.
# The older maps were constructed automatically, and give each row a score.
match ili-map-pwn*.tab
grammar table
columns ili synset score

claims
predicate-in-name - .
enter 1500 250
subject in ili
object in synset
score in score
