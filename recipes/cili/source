name cili
# The Collaborative Interlingual Index: language-independent concept identifiers, their definitions, and their maps
# to the wordnets. The definitions are Princeton WordNet's.
witness Collaborative Interlingual Index
lineage WordNet
class AcademicCurated
root $LAPLACE_DATA/.refresh-*/CILI/extracted
root $LAPLACE_DATA/CILI

# Measured when it was loaded: 6,055,916 compositions from 100 MB, at 750 bytes each with their indexes and standings.
room 46
after unicode iso-639
