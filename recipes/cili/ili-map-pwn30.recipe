name cili-map-pwn30
# CILI's two-column map: ILI, then the offset and part of speech used by
# Princeton WordNet 3.0. The offset is a release-specific pointer, not content.
match ili-map-pwn30.tab

tier row by \n
names ili offset
tier field by \t

thing row ili
content ili
types ili "Interlingual index concept" row
keyed ili row ili
keyed wordnet-3.0 row offset
