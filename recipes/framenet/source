name framenet
# FrameNet Release 1.7 (Berkeley FrameNet, ICSI), in the form NLTK redistributes: frames with their frame elements
# and lexical units, the relations between frames, the semantic types, the lemma and lexeme tables, and the annotated
# sentences of the lexical units and of the full texts.
# README.txt: "Welcome to Release 1.7 of the FrameNet data!" ... "The FrameNet database in XML format"
witness FrameNet
class AcademicCurated
root $LAPLACE_DATA/FrameNet/framenet_v17
# Measured when it was loaded: 15,952,613 compositions from 854 MB, at 750 bytes each with their indexes and standings.
room 14
after unicode iso-639
