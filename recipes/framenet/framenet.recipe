name framenet
# FrameNet's XML. Its things are what it names them: a frame its name (Abandonment), a frame element its frame and
# its name ([Abandonment, Agent]), a lexical unit its frame and its name ([Abandonment, abandon.v]), a sentence its
# text, a corpus and a document their names, a semantic type its name. These are the types the highway lists from
# FrameNet's own indexes (Semantics: Claims), so an element that carries only a number (FE ID="12338", lexUnit
# ID="14839", feID, luID, frameID) is read as the type that number is FrameNet's key of; the numbers themselves, with
# the ids of sentences, annotation sets, corpora, documents and the user who made an entry, are keys, recorded nowhere.
# Every other name and value is as the files write them.
match *.xml
grammar xml
key ID id corpID docID lemmaID cBy
# the file's bookkeeping, read by nothing: when an entry was made, display colours, annotation status and counts, where a
# sentence sat in its corpus, the schema declaration
omit cDate mDate bgColor fgColor status totalAnnotated numAnnotInstances hasAnnotation XMLCreated sentNo paragNo aPos sentenceCount header

# the things, and what names each
identity frame name
identity FE ID
identity lexUnit ID
identity lu ID
identity semType name
identity superType superTypeName
identity corpus name
identity document name within
identity sentence >text
identity memberFE ID
identity requiresFE ID
identity excludesFE ID

# the numbers FrameNet points at its types with, each read as the type
type frame.ID fnframe
type frameID fnframe
type FE.ID fnfe
type memberFE.ID fnfe
type requiresFE.ID fnfe
type excludesFE.ID fnfe
type feID fnfe
type subID fnfe
type supID fnfe
type lexUnit.ID fnlu
type lu.ID fnlu
type luID fnlu

# a frame's relation to another frame: <frameRelation type="Inherits from"><relatedFrame>Name</relatedFrame>
link frameRelation type >relatedFrame

# a label speaks of the stretch of its sentence's text from start to end; FrameNet's end is the last character
span label start end text inclusive name under layer.name
