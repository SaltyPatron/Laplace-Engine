name framenet
# FrameNet's XML. Its things are what it names them: a frame its name (Abandonment), a frame element its frame and
# its name ([Abandonment, Agent]), a lexical unit its frame and its name ([Abandonment, abandon.v]), a sentence its
# text, a corpus and a document their names, a semantic type its name. Frames, frame elements and lexical units are
# the types the highway lists, and their numbers (ID) are FrameNet's keys of them: where FrameNet points at one by its
# number (frameID, feID, luID, subID, supID, a member, required or excluded frame element) the number is read as the
# type it is the key of. The numbers of sentences, annotation sets, corpora and documents are keys. The user who made
# an entry (cBy, on a frame, a frame element, a lexical unit and a label) is content of FrameNet's record;
# FrameNet is the source witness. Every other name and value is as the files
# write them. What is no thing speaks of the nearest thing it is inside.
match *.xml
format xml

# the types, by the names FrameNet gives them; a frame element named in a lexical unit's own file is of that unit's frame
thing frame name
thing FE ^lexUnit/frame name
thing FE name within
# a lexical unit's own file names its frame; within a frame's file it is inside the frame
thing lexUnit frame name
thing lexUnit name within
thing lu frameName name
# what points at a type by FrameNet's number
thing memberFE ID
thing requiresFE ID
thing excludesFE ID
type memberFE.ID fnfe
type requiresFE.ID fnfe
type excludesFE.ID fnfe
type frameID fnframe
type feID fnfe
type luID fnlu
type lexUnit.ID fnlu
type frameRelation.subID fnframe
type frameRelation.supID fnframe
type FERelation.subID fnfe
type FERelation.supID fnfe
thing frameRelation subID
thing FERelation subID
# the things FrameNet names by their names
thing semType name
thing superType superTypeName
thing corpus name
thing document name within
thing sentence text
# An annotation is of its lexical unit at the source's target span. A layer is
# ONE ordered bundle of span labels in that context. Offsets are source codepoint
# offsets, with an inclusive end; retain them, including null instantiations.
# The layer name (PENN, BNC, FE, ...) identifies the tagset in the bundle. It is
# content, never a relation applied independently to every word it annotates.
thing annotationSet luID layer[name=Target]/label/start layer[name=Target]/label/end
thing annotationSet ^lexUnit/ID layer[name=Target]/label/start layer[name=Target]/label/end
thing annotationSet cxnName layer[name=Target]/label/start layer[name=Target]/label/end
thing layer of name rank label within
thing label start end name feID
thing label start end name
thing label itype name feID
thing label itype name

# Who made an entry is content of this source's record, not a new witness.
content cBy start end rank
# the file's bookkeeping, read by nothing: when an entry was made, display colours, annotation status and counts,
# where a sentence sat in its corpus, the schema declaration; and the numbers that are keys
omit cDate mDate bgColor fgColor status totalAnnotated numAnnotInstances hasAnnotation XMLCreated sentNo paragNo aPos sentenceCount header xmlns xmlns:* xsi:* ID corpID docID lemmaID
omit total cxnID order
# a semantic type's supertype is named beside its number (superTypeName); the number is its key
omit superType.supID
# the lexicon's own numbering of its lemmas, lexeme entries and word forms, and the lists of those numbers: keys,
# recorded nowhere (the file's nesting already holds which forms are of which lemma)
key Lemma id
key LexemeEntry id
key WordForm id
omit lexemeentryids wordformids lexemeid
content *

# What each part a claim is made of means (Laplace-Engine#32), never an attribute's, an element's or a layer's name:
# POS a value of FrameNet's part-of-speech list (N, V, A, ADV, PREP, ...): [lexical unit, N]; coreType a value of
# FrameNet's coreness ("core, peripheral, and extra-thematic"): [frame element, Core]; a frame relation's type
# (frameRelationType's name, Inheritance, Using, Subframe, ...; a frame file's "Inherits from") a relation of FrameNet's
# own frame-relation inventory. A lexeme's POS is said of its lexical unit, as before (POS, everywhere it stands).
value - POS coreType frameRelationType.name frameRelation.type
# a semantic type is a value of FrameNet's semantic-type hierarchy, said of the frame, frame element or lexical unit it
# is on: [frame, Container]. The FrameNet book (6.2.1): "These semantic types are used to classify the denotation of
# lexical units, frames, and frame elements."
value - semType
# The FrameNet book (3.1): "Thus, the frame elements in the Revenge frame are Avenger, Punishment, Offender, Injury,
# and Injured party." / "Lexical units in this frame include avenge.v, avenger.n, get even.v, ..."
relation "frame element" frame.FE
relation "lexical unit" frame.lexUnit
# The FrameNet book (3.2.2.2): "In this situation, we mark a Requires relation"; (3.2.2.3): "we say that Items excludes
# Item and Goal" ... "The Excludes relation also manifests in frames where ..."
relation "Requires" FE.requiresFE
relation "Excludes" FE.excludesFE
# The FrameNet book (3.1): "Some example sentences with the lexical unit avenge are given here." (a lexical unit's
# file holds its annotated sentences, by subcorpus)
relation "example sentence" subCorpus.sentence
# The FrameNet book (1): "complete frame and FE descriptions"; (2): "coming up with a description of each frame as a
# whole and each of its frame elements"
relation "description" frame.definition FE.definition
# The FrameNet book (1.1): "Like dictionary subentries, FrameNet lexical units come with definitions, either from the
# Concise Oxford Dictionary, 10th Edition ... or a definition written by a FrameNet staff member."
relation "come with definitions" lexUnit.definition
# The FrameNet book (3.2.4): "in the Placing frame, many verbs incorporate the Goal FE"
relation "incorporate" lexUnit.incorporatedFE
# The FrameNet book (B.1): "The Lexical Database contains the relationships of word forms, lexemes, lemmas, and their
# parts of speech." ... "A lemma may consist of multiple lexemes."
relation "consist of" lexeme.name
# The FrameNet book (6.2.1): "The types are related to each other via subtype relations, which are logically
# equivalent to Inheritance or is-a."
relation "subtype" superType.superTypeName
# The FrameNet book (3.2.7.3) writes a name and its short form so: "a new category of syntactic governor called
# Controller, abbreviated in the data as Ctrlr": an FE's abbrev is how its name is abbreviated in the data.
relation "abbreviated" FE.abbrev
# A valence unit's GF, PT and FE form one valence pattern, not three independent claims. Labels, including null
# instantiations CNI/DNI/INI and resolved feID pointers, stay inside the whole sentence layer above. The book (1):
# "get a new set of annotation layers (frame element, grammatical function, phrase type)". The documented layer
# meanings below state those bundles of their sentence, relative to the annotation set's target LU and offsets.
# A lexical unit retains one aligned lexeme path: names, POS, breakBefore
# and headword in source order. These flags describe positions inside this LU,
# so they remain in that bundle rather than becoming properties of the word
# independently of its lexical unit.
layers lexUnit lexeme name POS breakBefore headword
# A frame file's frameRelation is no thing (only frRelation.xml's, by its subID, are), so neither "holds frame
# frameRelation" nor "holds frameRelationType frameRelation" (a frameRelationType is no thing) ever made a claim: both
# are gone; frRelation.xml says each frame relation, under its type, below.

holds frame FE lexUnit semType
holds FE requiresFE excludesFE semType
holds lexUnit semType sentence
attest frame definition
attest FE coreType abbrev definition
attest lexUnit POS definition incorporatedFE
attest lu POS
attest lexeme name POS
attest semType superType
relate frameRelation ^/name to supID
relate FERelation ^/^/name to supID
relate frameRelation type to relatedFrame
# FrameNet's valence patterns align the FE, PT and GF of every constituent.
# One pattern is one claim, including absent GF slots, rather than independent
# properties of the LU. A second layers declaration preserves the lexeme axes.
thing pattern literal "valence pattern" within
layers pattern valenceUnit FE PT GF
# FrameNet II calls these "part of speech", "frame element", "grammatical
# function", "phrase type", "Named Entity Recognition" and "Target" layers.
# The relation is the source's documented meaning; its BNC/PENN/FE/... label
# stays in the bundle as a tagset identifier, never a per-word relation.
when name matches ^(BNC|PENN)$
dependence layer DerivedCalculation
relation "part of speech" layer.name
when name is FE
relation "frame element" layer.name
when name is GF
relation "grammatical function" layer.name
when name is PT
relation "phrase type" layer.name
when name is NER
relation "Named Entity Recognition" layer.name
when name is Target
relation "Target" layer.name
when name is WSL
relation "word status" layer.name
when name is Other
relation "special syntactic phenomena" layer.name
when name is Sent
relation "sentence annotation" layer.name
when name matches ^(Noun|Verb|Adj|Adv|Prep|Scon|Art)$
relation "part-of-speech-specific annotation" layer.name
# Construction annotation tagsets stay opaque bundles with their own names,
# labels and offsets. Their identifiers are not asserted as relation meanings.
when name matches ^(CEE|CE|CstrPT|GovX)$
relation "construction annotation layer" layer.name
always
relate layer name to . of ^sentence/text

# the highway: frames, frame elements and lexical units, by their numbers and (a frame) by its name, as VerbNet and
# PropBank write it; a frame element (as its frame defines it: with its core type) and a lexical unit map to their frame
types fnframe "FrameNet frame" frame
keyed fnframe frame ID
keyed fnframe frame name
when coreType matches .
types fnfe "FrameNet frame element" FE
keyed fnfe FE ID
maps FE ID fnfe to ^frame/ID fnframe
always
types fnlu "FrameNet lexical unit" lu
types fnlu "FrameNet lexical unit" lexUnit
keyed fnlu lu ID
keyed fnlu lexUnit ID
maps lu ID fnlu to frameID fnframe
maps lexUnit ID fnlu to frameID fnframe
maps lexUnit ID fnlu to ^frame/ID fnframe
