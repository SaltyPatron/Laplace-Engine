name framenet
# FrameNet's XML. FrameNet numbers each kind of thing from one: the number 4489 is a frame element, a lexical unit,
# a lemma, a lexeme and a word form, five different things. So a thing is named by its kind and its name together, as
# FrameNet's own attributes do when they refer to one (feID, luID, lemmaID, frameName): [FE, 4489], [frame, Abandonment].
# Every name and value is as the files write them.
match *.xml
grammar xml

# the things, and what names each
identity frame name kind
identity FE ID kind
identity lexUnit ID kind
identity lu ID kind lexUnit
identity semType name kind
identity superType superTypeName kind semType
identity corpus name kind
identity document name kind
identity sentence ID kind
identity annotationSet ID kind
identity annoSet ID kind annotationSet
identity frameRelationType name kind
identity statusType name kind
identity Lemma id kind
identity WordForm id kind
identity WordForm ID kind
identity Lexeme ID kind
# elements that are a frame element spoken of again
identity memberFE ID kind FE
identity requiresFE ID kind FE
identity excludesFE ID kind FE

# attributes that name a thing
refer lexUnit.frame frame
refer frameName frame
refer feID FE
refer luID lexUnit
refer lemmaID Lemma
refer frameRelation.subFrameName frame
refer frameRelation.superFrameName frame
refer FERelation.subID FE
refer FERelation.supID FE

# a frame's relation to another frame: <frameRelation type="Inherits from"><relatedFrame>Name</relatedFrame>
link frameRelation type >relatedFrame frame

# a label speaks of the stretch of its sentence's text from start to end; FrameNet's end is the last character
span label start end text inclusive
