name chess-com-games
match *.pgn
# PGN packaging uses formats/pgn.format; chess.c applies the legal board rules.
# Every game is a pure board-state trajectory [P0, P1, ..., Pn] replayed under firmware/chess.firmware, paired at the
# occurrence altitude with positional seats [seat_0, seat_1] (binding player/FIDE identity and compositional decimal Elo),
# structured numeric date/time-control/event metadata, and optional compositional integer decisecond ply clocks.
grammar pgn
records played
# Completed played games attest [position_before, position_after]
# with the result scored for the side making the move; * attests no outcome.
