name oewn
witness Open English WordNet
lineage WordNet
# Open English WordNet in WN-LMF XML. A curated source: what is recorded is what it attests, as claims between the
# entities it names, each in the source's own terms —
#   [lemma, partOfSpeech, n]         a lexical entry's lemma and its part of speech
#   [lemma, sense, sense id]         the lemma's senses
#   [sense id, synset, synset id]    each sense's synset
#   [sense id, relType, target]      relations between senses (antonym, derivation, …)
#   [synset id, ili|partOfSpeech|lexfile|members, value]
#   [synset id, Definition|Example|ILIDefinition, text]
#   [synset id, relType, target]     relations between synsets (hypernym, meronym, …)
#   [lemma, Form, form]
# Patterns name a record's first part by position (the lemma is an entry's first element, an identifier a tag's first
# attribute), so each is matched in time linear in the record: a pattern that pairs any two siblings is quadratic.
match english-wordnet-*.xml
grammar xml
# Enters unrated, at Glicko-2's stock deviation (350, trust 0.67); its trust is earned against higher-tier witnesses.
trust 0.67
query
([(EmptyElemTag (Name) @_n . (Attribute (Name) @_k (AttValue) @subject.xml) (Attribute (Name) @predicate (AttValue) @object.xml))
  (STag (Name) @_n . (Attribute (Name) @_k (AttValue) @subject.xml) (Attribute (Name) @predicate (AttValue) @object.xml))]
 (#eq? @_n "Lemma") (#eq? @_k "writtenForm") (#eq? @predicate "partOfSpeech"))

((element (STag (Name) @_le)
   (content . (CharData)? .
     (element [(STag (Name) @_l . (Attribute (Name) @_k (AttValue) @subject.xml))
               (EmptyElemTag (Name) @_l . (Attribute (Name) @_k (AttValue) @subject.xml))])
     (element [(STag (Name) @predicate . (Attribute (Name) @_i (AttValue) @object.xml))
               (EmptyElemTag (Name) @predicate . (Attribute (Name) @_i (AttValue) @object.xml))])))
 (#eq? @_le "LexicalEntry") (#eq? @_l "Lemma") (#eq? @_k "writtenForm") (#eq? @predicate "Sense") (#eq? @_i "id"))

((element (STag (Name) @_le)
   (content . (CharData)? .
     (element [(STag (Name) @_l . (Attribute (Name) @_k (AttValue) @subject.xml))
               (EmptyElemTag (Name) @_l . (Attribute (Name) @_k (AttValue) @subject.xml))])
     (element (EmptyElemTag (Name) @predicate . (Attribute (Name) @_w (AttValue) @object.xml)))))
 (#eq? @_le "LexicalEntry") (#eq? @_l "Lemma") (#eq? @_k "writtenForm") (#eq? @predicate "Form") (#eq? @_w "writtenForm"))

([(STag (Name) @_s . (Attribute (Name) @_i (AttValue) @subject.xml) (Attribute (Name) @predicate (AttValue) @object.xml))
  (EmptyElemTag (Name) @_s . (Attribute (Name) @_i (AttValue) @subject.xml) (Attribute (Name) @predicate (AttValue) @object.xml))]
 (#eq? @_s "Sense") (#eq? @_i "id") (#eq? @predicate "synset"))

((element (STag (Name) @_s . (Attribute (Name) @_i (AttValue) @subject.xml))
   (content (element (EmptyElemTag (Name) @_r .
     (Attribute (Name) @_t (AttValue) @predicate.xml) .
     (Attribute (Name) @_g (AttValue) @object.xml)))))
 (#any-of? @_s "Sense" "Synset") (#eq? @_i "id") (#any-of? @_r "SenseRelation" "SynsetRelation") (#eq? @_t "relType") (#eq? @_g "target"))

((STag (Name) @_s . (Attribute (Name) @_i (AttValue) @subject.xml) (Attribute (Name) @predicate (AttValue) @object.xml))
 (#eq? @_s "Synset") (#eq? @_i "id") (#any-of? @predicate "ili" "partOfSpeech" "lexfile" "members"))

((element (STag (Name) @_s . (Attribute (Name) @_i (AttValue) @subject.xml))
   (content (element (STag (Name) @predicate) (content) @object.xml)))
 (#eq? @_s "Synset") (#eq? @_i "id") (#any-of? @predicate "Definition" "Example" "ILIDefinition"))
end
