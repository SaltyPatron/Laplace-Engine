name propbank
# PropBank's frame files: every predicate's rolesets, their roles, and their links to VerbNet and FrameNet.
witness PropBank
# The deviation is this recipe's choice for a curated academic resource; the specification does not give one.
deviation 90
root $LAPLACE_DATA/.refresh-*/PropBank/extracted/propbank-*/frames
# Measured when it was loaded: 1,146,056 compositions from 30 MB, at 750 bytes each with their indexes and standings.
room 29
after unicode iso-639
