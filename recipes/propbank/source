name propbank
# PropBank's frame files: every predicate's rolesets, their roles, and their links to VerbNet and FrameNet.
witness PropBank
class AcademicCurated
root $LAPLACE_DATA/PropBank/propbank-*/frames
# Measured when it was loaded: 1,146,056 compositions from 30 MB, at 750 bytes each with their indexes and standings.
room 29
# The selected release excludes these malformed XML files (Laplace recipes/propbank/3.4/propbank.source.json):
# check.xml line 304 closes <arg> with </rel>; rend.xml line 38 has an unquoted src attribute.
except */frames/check.xml */frames/rend.xml
after unicode iso-639
