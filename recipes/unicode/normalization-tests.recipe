name unicode-normalization-tests
# UAX #15 conformance rows give a source and the four normalization results.
# Form-specific predicates name the standard operations, not packaging columns.
match NormalizationTest.txt

tier row by \n
comment hash
remark hash
padded
names source NFC NFD NFKC NFKD
tier field by ;

thing row source
codepoints source NFC NFD NFKC NFKD
unless_equal NFC source
unless_equal NFD source
unless_equal NFKC source
unless_equal NFKD source
# @Part directives label groups; they make no normalization claim.
when source matches ^[0-9A-Fa-f]
relation "normalizes to NFC" NFC
relation "normalizes to NFD" NFD
relation "normalizes to NFKC" NFKC
relation "normalizes to NFKD" NFKD
attest row NFC NFD NFKC NFKD
