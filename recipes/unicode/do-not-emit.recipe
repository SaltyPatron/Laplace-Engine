name unicode-do-not-emit
# DoNotEmit.txt. The header:
#   "#    Field 0  A sequence of Unicode code point values"
#   "#    Field 1  A replacement sequence of Unicode code point values"
#   "#    Field 2  DoNotEmit type of the original character sequence"
# Field 1 is described, not named: the sequence and its replacement are recorded as the pair the row writes,
# each as the text it is. A row whose sequence is a range speaks of the range.
match DoNotEmit.txt

tier row by \n
comment hash
remark hash
padded
names 0 1 "DoNotEmit type"
tier field by ;

thing row 0
range 0
codepoints 1
content "DoNotEmit type"
pair row 1
attest row "DoNotEmit type"
