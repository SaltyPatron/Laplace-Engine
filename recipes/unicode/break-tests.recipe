name unicode-break-tests
# UCD auxiliary test headers define ÷ as a break and × as no break.
# Keep the sample's codepoint sequence and its ordered boundary annotation
# together; a marker is a value, never a relation named after a column.
match GraphemeBreakTest.txt WordBreakTest.txt SentenceBreakTest.txt LineBreakTest.txt
format unicode_breaks
codepoints codepoint
content before after
thing token codepoint
thing record of token after
# The whole marker layer stays aligned with its sample, including repeated
# codepoints in different positions. No context-free break property is
# asserted about an isolated codepoint.
layers record token codepoint before
