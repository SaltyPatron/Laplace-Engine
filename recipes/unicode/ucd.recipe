name ucd
# The Unicode Character Database in XML (UAX #42), flat form: every codepoint, with everything the standard says of
# it: [codepoint, property, value], the property and the value as the standard writes them. A value that is itself
# codepoints is recorded as the text they are. The standard writes # for the codepoint itself: in a name it is written
# out; a property whose value is the codepoint itself says nothing further. What the standard leaves empty attests
# nothing. A range of codepoints (first-cp..last-cp) is not read here.
match ucd.all.flat.xml
grammar xml
itself #
subject-attribute cp

claims
enter 1500 350
query
([(EmptyElemTag (Name) @_el (Attribute (Name) @predicate (AttValue) @object.xml) @subject.attr)
  (STag (Name) @_el (Attribute (Name) @predicate (AttValue) @object.xml) @subject.attr)]
 (#eq? @_el "char")
 (#not-any-of? @object.xml "\"\"" "\"#\"")
 (#not-any-of? @predicate
   "bmg" "bpb" "cf" "dm" "FC_NFKC" "lc" "NFKC_CF" "NFKC_SCF" "scf" "slc" "stc" "suc" "tc" "uc" "EqUIdeo"))
end

claims
enter 1500 350
distinct
query
([(EmptyElemTag (Name) @_el (Attribute (Name) @predicate (AttValue) @object.cps) @subject.attr)
  (STag (Name) @_el (Attribute (Name) @predicate (AttValue) @object.cps) @subject.attr)]
 (#eq? @_el "char")
 (#any-of? @predicate
   "bmg" "bpb" "cf" "dm" "FC_NFKC" "lc" "NFKC_CF" "NFKC_SCF" "scf" "slc" "stc" "suc" "tc" "uc" "EqUIdeo"))
end

# a character's other names, and what kind of name each is
claims
enter 1500 350
query
((element (STag (Name) @_c . (Attribute (Name) @_k (AttValue) @subject.cp))
   (content (element (EmptyElemTag (Name) @predicate . (Attribute (Name) @_a (AttValue) @object.xml)))))
 (#eq? @_c "char") (#eq? @_k "cp") (#eq? @predicate "name-alias") (#eq? @_a "alias"))
((EmptyElemTag (Name) @_e . (Attribute (Name) @_a (AttValue) @subject.xml) . (Attribute (Name) @predicate (AttValue) @object.xml))
 (#eq? @_e "name-alias") (#eq? @_a "alias") (#eq? @predicate "type"))
end

# named sequences and standardized variants: said of the sequence, recorded as the text it is
claims
enter 1500 350
query
((EmptyElemTag (Name) @_el . (Attribute (Name) @predicate (AttValue) @object.xml) . (Attribute (Name) @_c (AttValue) @subject.cps))
 (#eq? @_el "named-sequence") (#eq? @predicate "name") (#eq? @_c "cps"))
((EmptyElemTag (Name) @_el . (Attribute (Name) @_c (AttValue) @subject.cps) (Attribute (Name) @predicate (AttValue) @object.xml))
 (#eq? @_el "standardized-variant") (#eq? @_c "cps") (#not-eq? @object.xml "\"\""))
((EmptyElemTag (Name) @_el . (Attribute (Name) @predicate (AttValue) @object.xml) . (Attribute (Name) @_r (AttValue) @subject.cps))
 (#eq? @_el "cjk-radical") (#eq? @predicate "number") (#eq? @_r "radical"))
end

# a radical's ideograph, and where each block begins and ends
claims
enter 1500 350
query
((EmptyElemTag (Name) @_el . (Attribute) . (Attribute (Name) @_r (AttValue) @subject.cps) . (Attribute (Name) @predicate (AttValue) @object.cps))
 (#eq? @_el "cjk-radical") (#eq? @_r "radical") (#eq? @predicate "ideograph"))
((EmptyElemTag (Name) @_el . (Attribute (Name) @predicate (AttValue) @object.cps) . (Attribute) . (Attribute (Name) @_n (AttValue) @subject.xml))
 (#eq? @_el "block") (#eq? @_n "name") (#eq? @predicate "first-cp"))
((EmptyElemTag (Name) @_el . (Attribute) . (Attribute (Name) @predicate (AttValue) @object.cps) . (Attribute (Name) @_n (AttValue) @subject.xml))
 (#eq? @_el "block") (#eq? @_n "name") (#eq? @predicate "last-cp"))
end
