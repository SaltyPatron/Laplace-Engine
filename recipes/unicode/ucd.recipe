name ucd
# The Unicode Character Database in XML (UAX #42), flat form: every codepoint of the codespace, with what the standard
# says of it. A curated source. What the standard gives as a binary or an enumerated property is a flag (laplace
# flags), not a claim. Everything else it says of a codepoint is attested: [codepoint, property, value], the property
# named as the standard says it. A value that is itself codepoints is recorded as the text they are, not as their
# numbers. What the standard leaves empty, or gives as the codepoint itself, attests nothing. A range of codepoints
# (first-cp..last-cp) attests nothing here: what the standard says of a range is in the flags of every codepoint in it.
# Script_Extensions is a set of scripts, not yet recorded.
match ucd.all.flat.xml
grammar xml
itself #
subject-attribute cp

claims
enter 1500 350
say predicate cjkAccountingNumeric = kAccountingNumeric
say predicate cjkOtherNumeric = kOtherNumeric
say predicate cjkPrimaryNumeric = kPrimaryNumeric
say predicate nv = Numeric Value
say predicate bmg = Bidi Mirroring Glyph
say predicate bpb = Bidi Paired Bracket
say predicate cf = Case Folding
say predicate cjkCompatibilityVariant = kCompatibilityVariant
say predicate dm = Decomposition Mapping
say predicate EqUIdeo = Equivalent Unified Ideograph
say predicate FC_NFKC = FC NFKC Closure
say predicate lc = Lowercase Mapping
say predicate NFKC_CF = NFKC Casefold
say predicate NFKC_SCF = NFKC Simple Casefold
say predicate scf = Simple Case Folding
say predicate slc = Simple Lowercase Mapping
say predicate stc = Simple Titlecase Mapping
say predicate suc = Simple Uppercase Mapping
say predicate tc = Titlecase Mapping
say predicate uc = Uppercase Mapping
say predicate cjkIICore = kIICore
say predicate cjkIRG_GSource = kIRG GSource
say predicate cjkIRG_HSource = kIRG HSource
say predicate cjkIRG_JSource = kIRG JSource
say predicate cjkIRG_KPSource = kIRG KPSource
say predicate cjkIRG_KSource = kIRG KSource
say predicate cjkIRG_MSource = kIRG MSource
say predicate cjkIRG_SSource = kIRG SSource
say predicate cjkIRG_TSource = kIRG TSource
say predicate cjkIRG_UKSource = kIRG UKSource
say predicate cjkIRG_USource = kIRG USource
say predicate cjkIRG_VSource = kIRG VSource
say predicate cjkMandarin = kMandarin
say predicate cjkRSUnicode = kRSUnicode
say predicate cjkTotalStrokes = kTotalStrokes
say predicate cjkUnihanCore2020 = kUnihanCore2020
say predicate isc = ISO Comment
say predicate JSN = Jamo Short Name
say predicate na = Name
say predicate na1 = Unicode 1 Name
query
([(EmptyElemTag (Name) @_el (Attribute (Name) @predicate (AttValue) @object.xml) @subject.attr)
  (STag (Name) @_el (Attribute (Name) @predicate (AttValue) @object.xml) @subject.attr)]
 (#eq? @_el "char")
 (#not-any-of? @object.xml "\"\"" "\"NaN\"" "\"#\"")
 (#not-any-of? @predicate
   "scx" "age" "blk" "sc" "bc" "bpt" "ccc" "dt" "ea" "gc" "GCB" "hst" "InCB" "InPC" "InSC" "jg" "jt" "lb" "NFC_QC"
   "NFD_QC" "NFKC_QC" "NFKD_QC" "nt" "SB" "vo" "WB" "AHex" "Alpha" "Bidi_C" "Bidi_M" "Cased" "CE" "CI" "Comp_Ex"
   "CWCF" "CWCM" "CWKCF" "CWL" "CWT" "CWU" "Dash" "Dep" "DI" "Dia" "EBase" "EComp" "EMod" "Emoji" "EPres" "Ext"
   "ExtPict" "Gr_Base" "Gr_Ext" "Gr_Link" "Hex" "Hyphen" "ID_Compat_Math_Continue" "ID_Compat_Math_Start" "IDC"
   "Ideo" "IDS" "IDSB" "IDST" "IDSU" "Join_C" "kEH_NoMirror" "kEH_NoRotate" "LOE" "Lower" "Math" "MCM" "NChar"
   "OAlpha" "ODI" "OGr_Ext" "OIDC" "OIDS" "OLower" "OMath" "OUpper" "Pat_Syn" "Pat_WS" "PCM" "QMark" "Radical" "RI"
   "SD" "STerm" "Term" "UIdeo" "Upper" "VS" "WSpace" "XIDC" "XIDS" "XO_NFC" "XO_NFD" "XO_NFKC" "XO_NFKD" "bmg"
   "bpb" "cf" "dm" "FC_NFKC" "lc" "NFKC_CF" "NFKC_SCF" "scf" "slc" "stc" "suc" "tc" "uc" "EqUIdeo"))
end

claims
enter 1500 350
distinct
say predicate bmg = Bidi Mirroring Glyph
say predicate bpb = Bidi Paired Bracket
say predicate cf = Case Folding
say predicate dm = Decomposition Mapping
say predicate EqUIdeo = Equivalent Unified Ideograph
say predicate FC_NFKC = FC NFKC Closure
say predicate lc = Lowercase Mapping
say predicate NFKC_CF = NFKC Casefold
say predicate NFKC_SCF = NFKC Simple Casefold
say predicate scf = Simple Case Folding
say predicate slc = Simple Lowercase Mapping
say predicate stc = Simple Titlecase Mapping
say predicate suc = Simple Uppercase Mapping
say predicate tc = Titlecase Mapping
say predicate uc = Uppercase Mapping
query
([(EmptyElemTag (Name) @_el (Attribute (Name) @predicate (AttValue) @object.cps) @subject.attr)
  (STag (Name) @_el (Attribute (Name) @predicate (AttValue) @object.cps) @subject.attr)]
 (#eq? @_el "char")
 (#any-of? @predicate
   "bmg" "bpb" "cf" "dm" "FC_NFKC" "lc" "NFKC_CF" "NFKC_SCF" "scf" "slc" "stc" "suc" "tc" "uc" "EqUIdeo"))
end
