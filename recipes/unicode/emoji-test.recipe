name unicode-emoji-test
# UTS #51 keyboard/display data: codepoint sequence, qualification, emoji name,
# emoji-version label and illustrative palette groups. Structured annotations
# after # are product. Ordinary comments and the repeated display glyph are
# packaging. Version labels: UTS51 revision29 section1.5.2.
# https://www.unicode.org/reports/tr51/tr51-29.html
match emoji-test.txt
format emoji_palette

thing palette header/group_name
thing subgroup header/subgroup_name
thing entry sequence
codepoints sequence
content status name version group_name subgroup_name
omit display

# Each qualification is a value of the source's list. Palette memberships use
# its own group vocabulary; they do not change an emoji's content identity.
value - status
relation "emoji name" name
relation "emoji version" version
attest entry status name version
pair entry ^palette ^subgroup
