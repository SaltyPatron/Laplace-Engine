name unicode-named-sequences
# NamedSequences.txt / NamedSequencesProv.txt define name; codepoint sequence.
# Use the same canonical sequence and predicate as ucd.recipe's XML records.
match NamedSequences.txt NamedSequencesProv.txt
format commented_table
names name sequence
tier field by ;
thing row sequence
codepoints sequence
content name
# File header: "Format: Name of Sequence; Code Point Sequence for USI".
relation "Name of Sequence" name
attest row name
