name unicode-derived-numeric-values
# extracted/DerivedNumericValues.txt. The header:
#   "# Derived Property:   Numeric_Value"
#   "#  Field 1:"
#   "#    The values are based on field 8 of UnicodeData.txt, plus the fields"
#   "#  Field 2:"
#   "#    This field is empty; it used to be a copy of the numeric type."
#   "#  Field 3:"
#   "#    expressing the same numeric value either as a whole integer"
#   "#    where possible, or as a rational fraction such as "1/6"."
# Both writings of the value are said of the code point under the property's name. A row whose code point is a
# range speaks of the range.
match DerivedNumericValues.txt

tier row by \n
comment hash
remark hash
padded
names 0 Numeric_Value 2 Numeric_Value
tier field by ;

thing row 0
range 0
content Numeric_Value
omit 2
attest row Numeric_Value
