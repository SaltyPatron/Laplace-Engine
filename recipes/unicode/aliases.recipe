name unicode-property-aliases
# The standard's own list of what each property's short name stands for: the two names, as written side by side.
match PropertyAliases.txt

tier row by \n
comment hash
remark hash
padded
names short long alias...
tier field by ;

thing row short
content short long alias
pair row long
# "Other aliases may be listed in additional fields" (the header): each one paired with the short name too
pair row alias
