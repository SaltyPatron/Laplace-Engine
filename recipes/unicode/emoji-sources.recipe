name unicode-emoji-sources
# EmojiSources.txt. The header:
#   "# Fields:"
#   "# 0: Unicode code point or sequence"
#   "# 1: DoCoMo Shift-JIS code"
#   "# 2: KDDI Shift-JIS code"
#   "# 3: SoftBank Shift-JIS code"
match EmojiSources.txt

tier row by \n
comment hash
remark hash
padded
names "Unicode code point or sequence" "DoCoMo Shift-JIS code" "KDDI Shift-JIS code" "SoftBank Shift-JIS code"
tier field by ;

thing row "Unicode code point or sequence"
codepoints "Unicode code point or sequence"
content "DoCoMo Shift-JIS code" "KDDI Shift-JIS code" "SoftBank Shift-JIS code"
attest row "DoCoMo Shift-JIS code" "KDDI Shift-JIS code" "SoftBank Shift-JIS code"
