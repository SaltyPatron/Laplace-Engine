name unicode-confusables
# UTS #39 confusables and intentional confusables. Neither file names its fields, and UTS #39 is not on this
# machine: what is recorded is the pair the row writes, in the row's order, each side as the text it is. The
# columns are numbered here only to say where a part is; no name is recorded. The third field of confusables.txt
# (always MA) is read by nothing.
match confusables.txt intentional.txt

tier row by \n
comment hash
remark hash
padded
names 0 1 2
tier field by ;

thing row 0
range 0
codepoints 1
omit 2
pair row 1
