name unicode-normalization-corrections
# NormalizationCorrections.txt. The header:
#   "#   Field 0: Unicode code point"
#   "#   Field 1: Original (erroneous) decomposition"
#   "#   Field 2: Corrected decomposition"
#   "#   Field 3: Version of Unicode for which the correction was"
#   "#            entered into UnicodeData.txt, in n.n.n format."
# The decompositions are recorded as the text they are. Field 3, the version a correction was entered in, is
# bookkeeping, read by nothing.
match NormalizationCorrections.txt

tier row by \n
comment hash
remark hash
padded
# The columns are numbered as the header numbers them, only to say where a part is; what each says is its header line.
names 0 1 2 3
tier field by ;

thing row 0
codepoints 0 1 2
omit 3
# "Field 1: Original (erroneous) decomposition"
relation "Original (erroneous) decomposition" 1
# "Field 2: Corrected decomposition"
relation "Corrected decomposition" 2
attest row 1 2
