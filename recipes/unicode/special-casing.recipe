name unicode-special-casing
# SpecialCasing.txt. The header names the fields:
#   "# <code>; <lower>; <title>; <upper>; (<condition_list>;)? # <comment>"
#   "# The <condition_list> is optional. Where present, it consists of one or more language IDs"
#   "# or casing contexts, separated by spaces."
# Only the rows that carry a condition_list attest here: the rows without one are the full case mappings the
# XML gives as lc, tc and uc. A row says each of its mappings, as the text it is, and each condition of its list.
# A mapping the row leaves empty attests nothing.
match SpecialCasing.txt

tier row by \n
comment hash
remark hash
padded
names code lower title upper condition_list
tier field by ;
part condition_list by space

thing row code
range code
codepoints lower title upper
content condition_list
when condition_list matches [A-Za-z]
attest row lower title upper condition_list
