name unicode-uca-decomps
# The decompositions used in generating the Default Unicode Collation Element Table. The header:
#   "# Field 0: code point"
#   "# Field 1: decomposition tag"
#   "# Field 2: decomposition"
# The decomposition is recorded as the text it is.
match decomps.txt

tier row by \n
comment hash
remark hash
padded
names "code point" "decomposition tag" decomposition
tier field by ;

thing row "code point"
codepoints "code point" decomposition
content "decomposition tag"
# The header: "The decomposition tags in this file are derived from the normative Decomposition_Type values, but differ from
# them, in part because of the introduction of the "<sort>" tag.": a value of the file's own list of tags
value - "decomposition tag"
# The header: "This file lists decompositions used in generating the Default Unicode Collation Element Table (DUCET)"
relation "decompositions used in generating the ... (DUCET)" decomposition
attest row "decomposition tag" decomposition
