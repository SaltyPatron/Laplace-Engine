name ucd-xml
# The Unicode Character Database in XML (UAX #42), flat form. Every property of a codepoint element attests that
# codepoint: [codepoint, property, value], with the database as witness. A range element (first-cp..last-cp) attests
# itself as recorded; its properties are not copied to each codepoint in it.
match ucd.all.flat.xml ucd.nounihan.flat.xml
grammar xml
# The standard that defines these properties.
trust 1.0
subject-attribute cp first-cp last-cp
query
((EmptyElemTag
   (Name) @_el
   (Attribute (Name) @predicate (AttValue) @object.xml) @subject.attr)
 (#any-of? @_el "char" "reserved" "noncharacter" "surrogate"))
end
