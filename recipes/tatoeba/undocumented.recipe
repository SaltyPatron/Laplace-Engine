name tatoeba-undocumented
# tags_detailed.csv and tag_metadata.csv: Tatoeba's page does not give their fields. No column is given a name: a
# row is recorded as the tuple of its fields, in the row's own order.
match tags_detailed.csv tag_metadata.csv
grammar table
escaped \
# "\N: Unknown (rare)."
empty-matches ^\\N$

claims
row tuple
