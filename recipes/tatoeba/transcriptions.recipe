name tatoeba-transcriptions
# "Contains all transcriptions in auxiliary or alternative scripts."
# Fields: Sentence id [tab] Lang [tab] Script name [tab] Username [tab] Transcription
# Of the sentence, the member says its transcription in the script named; the row says the sentence's language.
match transcriptions.csv

tier row by \n
escaped \
names "Sentence id" Lang "Script name" Username Transcription
tier field by \t
empty \\N

thing row "Sentence id"
refer "Sentence id" tatoeba-sentences
own Username
content Lang "Script name" Transcription
relate row "Script name" to Transcription by Username
attest row Lang
