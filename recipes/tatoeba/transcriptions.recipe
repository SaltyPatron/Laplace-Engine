name tatoeba-transcriptions
# "Contains the transcriptions of sentences" in another script, with "the username of the user who last modified
# the transcription".
# Fields and structure: Sentence id [tab] Lang [tab] Script name [tab] Username [tab] Transcription
# The sentence id is read as the sentence; the script's name is what the transcription is said under.
match transcriptions.csv
grammar table
escaped \\
# "\\N: Unknown (rare)."
empty-matches ^\\\\N$
columns "Sentence id" Lang "Script name" Username Transcription
refer "Sentence id" tatoeba-sentences
kinds own
kind Username Username

claims
subject in "Sentence id"
predicate in "Script name"
object in Transcription
witness in Username

claims
subject in "Sentence id"
attest Lang
