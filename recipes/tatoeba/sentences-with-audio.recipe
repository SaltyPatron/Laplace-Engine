name tatoeba-sentences-with-audio
# "Contains the ids of the sentences, for which audio is available" with the audio's id, "the username of the
# user who recorded the sentence, the license of the audio and the attribution url".
# Fields and structure: Sentence id [tab] Audio id [tab] Username [tab] License [tab] Attribution URL
# The sentence id is read as the sentence; the audio id is a key to a recording not in the data, recorded nowhere.
match sentences_with_audio.csv
grammar table
escaped \\
# "\\N: Unknown (rare)."
empty-matches ^\\\\N$
columns "Sentence id" "Audio id" Username License "Attribution URL"
refer "Sentence id" tatoeba-sentences
key "Audio id"
kinds own
kind Username Username

claims
subject in "Sentence id"
attest Username
