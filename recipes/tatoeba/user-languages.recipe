name tatoeba-user-languages
# "Contains the self-reported skill levels of members in individual languages."
# Fields: Lang [tab] Skill level [tab] Username [tab] Details
# A member says of themself, in a language, a skill level and details: the thing is the member with the language.
match user_languages.csv

tier row by \n
escaped \
names Lang "Skill level" Username Details
tier field by \t
empty \\N

thing row Username Lang
own Username
content Lang "Skill level" Details
attest row "Skill level" Details by Username
