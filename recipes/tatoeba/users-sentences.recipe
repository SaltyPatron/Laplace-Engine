name tatoeba-users-sentences
# "Contains sentences reviewed by users. The value of the review can be -1 (sentence not OK), 0 (undecided or
# unsure), or 1 (sentence OK). Warning: this data is still experimental."
# Fields: Username [tab] Sentence id [tab] Review [tab] Date added [tab] Date last modified
# Tatoeba reports a member's review of a sentence: [member, [sentence, sentence OK,
# original review value]]. The dates are Tatoeba's bookkeeping.
match users_sentences.csv

tier row by \n
escaped \
names Username "Sentence id" Review "Date added" "Date last modified"
tier field by \t
empty \\N

thing row "Sentence id" literal "sentence OK" Review
refer "Sentence id" tatoeba-sentences-detailed tatoeba-sentences tatoeba-sentences-cc0
content Username
content Review
omit "Date added" "Date last modified"
# The corpus reports a member's review. Preserve its original -1/0/1 value as
# content in the judgment; do not turn the person into an independent witness.
pair row . of Username

# The publisher filters sentence exports by correctness and licence, while
# related exports include a wider domain. Only admit relations on exported
# sentences. Missing IDs are counted as domain exclusions, never invented.
# https://github.com/Tatoeba/tatoeba2/blob/f2c80b81032630648f7896182174a9f5784ccde2/docs/database/scripts/weekly_exports.sql
admit references "Sentence id"
