name tatoeba-links
# "Contains the links between the sentences. 1 [tab] 77 means that sentence #77 is the translation of sentence #1.
# The reciprocal link is also present"   Fields and structure: Sentence id [tab] Translation id
# Both ids are keys of sentences.csv's rows: each is read as the sentence it points at, so a row says of one
# sentence that another is its translation.
match links.csv

tier row by \n
escaped \
names "Sentence id" "Translation id"
tier field by \t
# "\\N: Unknown (rare)."
empty \\N

# The page says of the row 1 [tab] 77 that "sentence #77 is the translation of sentence #1": the row's thing is the
# sentence "Translation id" points at, and it is the translation of the one "Sentence id" points at:
# [77, is the translation of, 1]. Both ids are pointers (Laplace-Engine#20), resolved and in no claim; the reciprocal
# row says the reverse.
thing row "Translation id"
refer "Sentence id" tatoeba-sentences
refer "Translation id" tatoeba-sentences
# "1 [tab] 77 means that sentence #77 is the translation of sentence #1."
relation "is the translation of" "Sentence id"
attest row "Sentence id"
