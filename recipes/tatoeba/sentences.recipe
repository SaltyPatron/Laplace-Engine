name tatoeba-sentences
# "Contains all the sentences in the selected language. Each sentence is associated with a unique id and an
# ISO 639-3 language code."   Fields and structure: Sentence id [tab] Lang [tab] Text
# A sentence is its text; its id is Tatoeba's key to it, by which the other files point at it.
match sentences.csv

tier row by \n
escaped \
names "Sentence id" Lang Text
tier field by \t
# "\\N: Unknown (rare)."
empty \\N

thing row Text
content Text Lang
key row "Sentence id"
# "Each sentence is associated with a unique id and an ISO 639-3 language code." (sentences.csv; the other files
# name the same field Lang): the sentence's language code
relation "ISO 639-3 language code" Lang
attest row Lang
