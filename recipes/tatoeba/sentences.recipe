name tatoeba-sentences
# "Contains all the sentences in the selected language. Each sentence is associated with a unique id and an
# ISO 639-3 language code."   Fields and structure: Sentence id [tab] Lang [tab] Text
match sentences.csv
grammar table
escaped \
# "\N: Unknown (rare)."
empty-matches ^\\N$
columns "Sentence id" Lang Text
kinds own
kind "Sentence id" "Sentence id"

claims
subject in "Sentence id"
attest Lang Text
