name tatoeba-tags
# "Contains the list of tags associated with each sentence. 381279 [tab] proverb means that sentence #381279 has
# been assigned the "proverb" tag."   Fields and structure: Sentence id [tab] Tag name
# The id is a key of sentences.csv's rows, read as the sentence.
match tags.csv

tier row by \n
escaped \
names "Sentence id" "Tag name"
tier field by \t
# "\\N: Unknown (rare)."
empty \\N

thing row "Sentence id"
refer "Sentence id" tatoeba-sentences-detailed tatoeba-sentences tatoeba-sentences-cc0
content "Tag name"
# A tag (the page, above: "has been assigned the "proverb" tag") is a value of Tatoeba's own tag vocabulary:
# [sentence, proverb].
value - "Tag name"
attest row "Tag name"

# The publisher filters sentence exports by correctness and licence, while
# related exports include a wider domain. Only admit relations on exported
# sentences. Missing IDs are counted as domain exclusions, never invented.
# https://github.com/Tatoeba/tatoeba2/blob/f2c80b81032630648f7896182174a9f5784ccde2/docs/database/scripts/weekly_exports.sql
admit references "Sentence id"
