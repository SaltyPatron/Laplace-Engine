name tatoeba-sentences-cc0
# "Contains all the sentences that are released under CC0" with "the date of the last modification".
# Fields and structure: Sentence id [tab] Lang [tab] Text [tab] Date last modified
# A sentence is its text; the id is a key, recorded nowhere.
match sentences_CC0.csv
grammar table
escaped \\
# "\\N: Unknown (rare)."
empty-matches ^\\\\N$
columns "Sentence id" Lang Text "Date last modified"
key "Sentence id"

claims
subject in Text
attest Lang "Date last modified"
