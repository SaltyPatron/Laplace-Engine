name tatoeba-sentences-cc0
# "Contains all the sentences available under CC0."   Fields: Sentence id [tab] Lang [tab] Text [tab] Date last modified
# A sentence is its text; its id is Tatoeba's key to it. The date is Tatoeba's bookkeeping.
match sentences_CC0.csv

tier row by \n
escaped \
names "Sentence id" Lang Text "Date last modified"
tier field by \t
# "\\N: Unknown (rare)."
empty \\N

thing row Text
key row "Sentence id"
content Text Lang
omit "Date last modified"
attest row Lang
