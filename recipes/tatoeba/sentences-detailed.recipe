name tatoeba-sentences-detailed
# "Contains additional fields for each sentence (owner name, date created/modified)."
# Fields: Sentence id [tab] Lang [tab] Text [tab] Username [tab] Date added [tab] Date last modified
# A sentence is its text; Username is the column the page calls "owner name". A member stands within Tatoeba:
# [Tatoeba, Username, the name]. The dates are Tatoeba's bookkeeping.
match sentences_detailed.csv

tier row by \n
escaped \
names "Sentence id" Lang Text Username "Date added" "Date last modified"
tier field by \t
empty \\N

thing row Text
key row "Sentence id"
own Username
content Text Lang
omit "Date added" "Date last modified"
attest row Lang by Username
