name oewn
# Open English WordNet in WN-LMF XML. A curated source: what is recorded is what it attests, between the entities it
# is about, never the file's own identifiers. A sense is its concept, named by its ILI:
#   [lemma, eng, ILI]                 a lexicalization, with the language as the predicate; senses in the order given
#   [lemma, POS, n]   [ILI, POS, n]   the part of speech of a lemma and of a concept
#   [ILI, hypernym, ILI]              relations between concepts, named as WordNet's documentation names them
#   [ILI, definition, text]  [ILI, example, text]
# A synset without an ILI (ili="in") attests nothing yet.
# Patterns name a record's first part by position (the lemma is an entry's first element, an identifier a tag's first
# attribute), so each is matched in time linear in the record: a pattern that pairs any two siblings is quadratic.
match english-wordnet-*.xml
grammar xml

map ili
((STag (Name) @_s . (Attribute (Name) @_i (AttValue) @key.xml) . (Attribute (Name) @_l (AttValue) @value.xml))
 (#eq? @_s "Synset") (#eq? @_i "id") (#eq? @_l "ili") (#match? @value.xml "^i[0-9]+$"))
end

map pos
((STag (Name) @_s . (Attribute (Name) @_i (AttValue) @key.xml) . (Attribute (Name) @_l (AttValue) @_v)
   (Attribute (Name) @_p (AttValue) @value.xml))
 (#eq? @_s "Synset") (#eq? @_i "id") (#eq? @_l "ili") (#match? @_v "^i[0-9]+$") (#eq? @_p "partOfSpeech"))
end

claims
predicate eng
enter 1500 350
ordered
query
((element (STag (Name) @_le)
   (content . (CharData)? .
     (element [(STag (Name) @_l . (Attribute (Name) @_k (AttValue) @subject.xml))
               (EmptyElemTag (Name) @_l . (Attribute (Name) @_k (AttValue) @subject.xml))])
     (element [(STag (Name) @_sn (Attribute (Name) @_y (AttValue) @object.xml.ili) .)
               (EmptyElemTag (Name) @_sn (Attribute (Name) @_y (AttValue) @object.xml.ili) .)])))
 (#eq? @_le "LexicalEntry") (#eq? @_l "Lemma") (#eq? @_k "writtenForm") (#eq? @_sn "Sense") (#eq? @_y "synset"))
end

claims
predicate POS
enter 1500 250
say object s = a
query
((element (STag (Name) @_le)
   (content . (CharData)? .
     (element [(STag (Name) @_l . (Attribute (Name) @_k (AttValue) @subject.xml))
               (EmptyElemTag (Name) @_l . (Attribute (Name) @_k (AttValue) @subject.xml))])
     (element [(STag (Name) @_sn (Attribute (Name) @_y (AttValue) @object.xml.pos) .)
               (EmptyElemTag (Name) @_sn (Attribute (Name) @_y (AttValue) @object.xml.pos) .)])))
 (#eq? @_le "LexicalEntry") (#eq? @_l "Lemma") (#eq? @_k "writtenForm") (#eq? @_sn "Sense") (#eq? @_y "synset"))

((STag (Name) @_s . (Attribute) . (Attribute (Name) @_l (AttValue) @subject.xml)
   (Attribute (Name) @_p (AttValue) @object.xml))
 (#eq? @_s "Synset") (#eq? @_l "ili") (#match? @subject.xml "^i[0-9]+$") (#eq? @_p "partOfSpeech"))
end

claims
enter 1500 250
distinct
spaces predicate _
say predicate instance_hypernym = instance hypernym
say predicate instance_hyponym = instance hyponym
say predicate mero_member = member meronym
say predicate holo_member = member holonym
say predicate mero_part = part meronym
say predicate holo_part = part holonym
say predicate mero_substance = substance meronym
say predicate holo_substance = substance holonym
say predicate similar = similar to
say predicate also = also see
say predicate entails = entailment
say predicate causes = cause
say predicate domain_topic = domain of synset topic
say predicate has_domain_topic = member of domain topic
query
((element (STag (Name) @_s . (Attribute (Name) @_i (AttValue) @subject.xml.ili))
   (content (element (EmptyElemTag (Name) @_r .
     (Attribute (Name) @_t (AttValue) @predicate.xml) .
     (Attribute (Name) @_g (AttValue) @object.xml.ili)))))
 (#eq? @_s "Synset") (#eq? @_i "id") (#eq? @_r "SynsetRelation") (#eq? @_t "relType") (#eq? @_g "target"))
end

claims
enter 1500 250
say predicate Definition = definition
say predicate Example = example
say predicate ILIDefinition = definition
query
((element (STag (Name) @_s . (Attribute (Name) @_i (AttValue) @subject.xml.ili))
   (content (element (STag (Name) @predicate) (content) @object.xml)))
 (#eq? @_s "Synset") (#eq? @_i "id") (#any-of? @predicate "Definition" "Example" "ILIDefinition"))
end
