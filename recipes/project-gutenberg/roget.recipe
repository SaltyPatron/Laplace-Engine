name gutenberg-roget
# Roget's Thesaurus of English Words and Phrases (Project Gutenberg eBook #10681).
# Category lines pairing a numbered concept heading with its synonyms and expressions.
match rogets-thesaurus-of-english-words-and-phrases.txt
witness Roget's Thesaurus of English Words and Phrases
lineage Project Gutenberg
class UserCuratedResource
tier line by \n
line ^#?[0-9]+[a-z]?\. +([A-Za-z][^.—-]+)[.—-]+ *(N\.|V\.|Adj\.|Adv\.|Phr\.) +(.*) :: claim
line ^ *(N\.|V\.|Adj\.|Adv\.|Phr\.|Int\.) +(.*) :: pair
