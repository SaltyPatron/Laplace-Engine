name file
# What a file is within its source: its pathname from the source's root and its filename (POSIX). Nothing the OS
# keeps about one copy of it (inode, owner, device, times) is the file: the same file at the same place in the same source
# is the same trunk on every machine and at every reading.
metadata pathname filename
omit stx_mode stx_uid stx_gid stx_nlink stx_ino stx_size stx_blocks stx_blksize stx_attributes
omit stx_dev_major stx_dev_minor stx_rdev_major stx_rdev_minor stx_btime stx_ctime stx_mtime stx_atime
