name hatecheck-cases
# HateCheck's README names every column of "test_suite_cases.csv" and "all_cases.csv":
#   case_id "The unique ID of the test case"; test_case "The text of the test case."; label_gold "The gold standard
#   label (hateful/non-hateful) of the test case"; ref_case_id "the ID of the simpler hateful case which was
#   perturbed to generate them", or "of the hateful case which is contrasted"; ref_templ_id "The equivalent, but for
#   template IDs."; templ_id "The unique ID of the template from which the test case was generated"
# A case is its test case, the sentence itself; case_id, templ_id and ref_templ_id are HateCheck's keys; ref_case_id
# points at another case by its key, read as that case's sentence. What a row says of its case it says together.
# The first column has no name and says nothing.
match all_cases.csv test_suite_cases.csv

tier row by \n
header
quoted
tier field by ,
# "-" is what the file writes where a case has no direction, focus word, lemma or case it refers to
empty -

thing row test_case
key row case_id
key row templ_id
key row ref_templ_id
refer ref_case_id hatecheck-cases
content test_case functionality label_gold target_ident direction focus_words focus_lemma case_templ
together row
attest row functionality label_gold target_ident direction focus_words focus_lemma ref_case_id case_templ
