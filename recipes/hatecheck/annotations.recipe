name hatecheck-annotations
# The labels the annotators gave each test case, a case on every row, named by its case_id. The first row names
# the columns: label_1 to label_10 are each the label "provided for the test case by a given annotator" (README),
# so an annotator is known only by the number in the column's name. The first column has no name: not attested.
# A field written with a doubled double quote is left unread, as in hatecheck-cases.
match all_annotations.csv test_suite_annotations.csv
grammar csv
records

claims
predicate functionality
query
(row . (field) . (field) @object.text . (field) @subject.text (#not-eq? @subject.text "case_id") (#not-match? @subject.text "\"\"") (#not-match? @object.text "\"\""))
end

claims
predicate templ_id
query
(row . (field) . (field) . (field) @subject.text . (field) @object.text (#not-eq? @subject.text "case_id") (#not-match? @subject.text "\"\"") (#not-match? @object.text "\"\""))
end

