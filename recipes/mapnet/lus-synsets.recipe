name mapnet-lus-synsets
# README:
#   "- file 'mapping_lus_synsets.txt':
#      mapping between FrameNet frames, lus and WordNet synsets (5,162 mappings)."
# The file has no header row and the README names no column: each row is recorded as a tuple of its three fields, in
# the row's own order. The names after "columns" only point at a position in the row and are never recorded.
match mapping_lus_synsets.txt
grammar table
columns frames lus synsets

claims
subject in frames
predicate in lus
object in synsets
