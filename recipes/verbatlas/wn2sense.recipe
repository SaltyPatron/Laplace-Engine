name verbatlas-wn2sense
# README.txt, FORMAT, 11. wn2sense.tsv:
#   "A mapping from a WordNet synset to a WordNet sense key. Each line contains a
#    WordNet synset ID and a WordNet sense key, separated by a tab."
# The predicate is the README's name for the second column. The names after "columns" only point at a position in the
# row and are never recorded.
# This file has no licence line: its first line is a row.
match wn2sense.tsv
grammar table
columns WordNet_synset_ID WordNet_sense_key

claims
predicate WordNet sense key
subject in WordNet_synset_ID
object in WordNet_sense_key
