name verbatlas-preference-info
# A selectional preference on each row: its id (va:0001p, a key), its reference BabelNet synset (read as the ILI
# concept), its name, and a picture of it (a fourth column the file does not name: a pair). The first line is the
# release's banner, not a row.
match VA_preference_info.tsv

tier row by \n
skip 1
names ID reference_BabelNet_synset_ID name fourth
tier field by \t

thing row name
key row ID
type reference_BabelNet_synset_ID ili
content name fourth
attest row reference_BabelNet_synset_ID
pair row fourth
