name verbatlas-preference-info
# README.txt: "Each line contains the ID of a VerbAtlas selectional preference, its reference BabelNet synset ID, and
# its name"; a fourth column, a picture of it, the README does not name (a pair). The id (va:0001p) is a key. The
# BabelNet ID is recorded as written: these are noun synsets, and VerbAtlas's bn2wn maps only verbs to WordNet. The
# first line is the release's banner, not a row.
match VA_preference_info.tsv

tier row by \n
skip 1
names ID "reference BabelNet synset ID" name fourth
tier field by \t

thing row name
key row ID
content name "reference BabelNet synset ID" fourth
attest row "reference BabelNet synset ID"
pair row fourth
