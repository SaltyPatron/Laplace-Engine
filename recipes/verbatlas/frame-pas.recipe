name va-frame-pas
# A frame (by its id, read as the frame) and its predicate-argument structure: the roles, in order. The row is the
# tuple of them, attested as it is. The first line is the release's banner, not a row.
match VA_frame_pas.tsv

tier row by \n
skip 1
names frame
tier field by \t

thing row .
type frame vaframe
itself row
