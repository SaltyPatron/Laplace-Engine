name va-implicit
# README.txt section 7: a synset's implicit arguments, with one or more role/filler
# pairs. This category is distinct from the shadow arguments of the same synset.
match VA_bn2implicit.tsv

tier row by \n
skip 1
names synset role1 filler1 role2 filler2 role3 filler3 role4 filler4 overflow...
tier field by \t
part filler* by |

thing row synset literal "implicit argument"
type synset ili
# See shadow.recipe: fillers retain their original BabelNet identifiers.
content role* filler* overflow
itself row
together row
value - role*
relate row role1 to filler1
relate row role2 to filler2
relate row role3 to filler3
relate row role4 to filler4
attest row overflow
