name verbatlas-frame-info
# A frame on each row: its id (va:0001f, the key VerbAtlas points at the frame with), its name (TOLERATE, what the
# frame is, the type the highway lists), its definition, its prototypical BabelNet synset (a key of a
# WordNet synset, read as the ILI concept), that synset's definition, and a small definition.
# The first line is the release's banner (name, version, licence), not a row.
match VA_frame_info.tsv

tier row by \n
skip 1
names ID name definition prototypical_synset definition_of_the_prototypical_synset small_definition
tier field by \t

thing row name
key row ID
type prototypical_synset ili
content name definition definition_of_the_prototypical_synset small_definition
attest row definition prototypical_synset definition_of_the_prototypical_synset small_definition

# the highway: a frame is its name (TOLERATE), and its id (va:0001f) is VerbAtlas's key of it
types vaframe "VerbAtlas frame" row
keyed vaframe row ID
