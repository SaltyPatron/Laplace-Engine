name verbatlas-bn2wn
# README.txt, FORMAT, 9. bn2wn.tsv:
#   "A mapping from BabelNet synset to WordNet synset for verbs. Each line contains a
#    BabelNet synset ID and its corresponding WordNet synset ID, separated by a tab."
# The predicate is the README's name for the second column. The names after "columns" only point at a position in the
# row and are never recorded.
# The file's first line is a licence line ("# BabelNet 4.0.1 - SapienzaNLP - LICENSE: ..."), not a row.
match bn2wn.tsv
grammar table
comment #
columns BabelNet_synset_ID WordNet_synset_ID

claims
predicate WordNet synset ID
subject in BabelNet_synset_ID
object in WordNet_synset_ID
