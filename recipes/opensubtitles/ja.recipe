name opensubtitles-en-ja-ja
# The aligned partner of OpenSubtitles.en-ja.en; README calls these
# "translated movie subtitles" with sentence alignment. Both languages belong
# to the translation strand. The line pointer is resolved, never recorded.
match OpenSubtitles.en-ja.ja

tier sentence by \n
numbered aligned
names text
tier field by \t

thing sentence text literal jpn
content text
refer aligned opensubtitles-en-ja-en
relation "translated" aligned
attest sentence aligned
