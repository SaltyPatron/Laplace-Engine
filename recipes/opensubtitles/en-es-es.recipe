name opensubtitles-en-es-es
# The aligned partner of OpenSubtitles.en-es.en; README calls these
# "translated movie subtitles" with sentence alignment. Both languages belong
# to the translation strand. The line pointer is resolved, never recorded.
match OpenSubtitles.en-es.es

tier sentence by \n
numbered aligned
names text
tier field by \t

thing sentence text literal spa
content text
refer aligned opensubtitles-en-es-en
relation "translated" aligned
attest sentence aligned
