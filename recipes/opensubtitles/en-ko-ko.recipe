name opensubtitles-en-ko-ko
# The aligned partner of OpenSubtitles.en-ko.en; README calls these
# "translated movie subtitles" with sentence alignment. Both languages belong
# to the translation strand. The line pointer is resolved, never recorded.
match OpenSubtitles.en-ko.ko

tier sentence by \n
numbered aligned
names text
tier field by \t

thing sentence text literal kor
content text
refer aligned opensubtitles-en-ko-en
relation "translated" aligned
attest sentence aligned
