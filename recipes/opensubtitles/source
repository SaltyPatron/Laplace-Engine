name opensubtitles
# OpenSubtitles v2024 as OPUS packages it "in Moses format": for each pair of languages two files of plain text, one
# sentence on a line, and a README and a LICENSE. The README's first line: "Corpus Name: OpenSubtitles".
witness OpenSubtitles
# The README: "This package is part of OPUS - the open collection of parallel corpora".
lineage OPUS
class StructuredCorpus
# Recurse across every locally extracted pair directory, including ar/de/el-en.
# Pair recipes bind both ISO language identities and keep line keys pair-local.
root $LAPLACE_DATA/OpenSubtitles
after unicode iso-639
