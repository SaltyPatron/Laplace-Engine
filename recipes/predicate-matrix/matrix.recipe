name predicate-matrix
# PredicateMatrix.v1.3.txt: "Each row of this Predicate Matrix represents the mapping of a role over the different
# resources and includes all the aligned knowledge about its corresponding verb sense ... Each row is indetified by
# the unique index formed by the first four columns." A tab parts the fields; the first row names them. Every value is
# written after the resource it is of (vn:51.3.1, fn:Body_movement, pb:drop.01, mcr:ili-30-01976841-v, wn:drop%2:38:00),
# and NULL is what the matrix writes where a resource has nothing for the row.
# A VerbNet class, a FrameNet frame, a PropBank roleset or a WordNet synset is read as the type the matrix's key
# names. The highway maps the concepts, classes, frames and rolesets a row aligns.
match PredicateMatrix.v*.txt

tier row by \n
header
tier field by \t
empty id:NULL vn:NULL wn:NULL mcr:NULL fn:NULL pb:NULL eso:NULL

type 5_VN_CLASS vnclass matching ^vn:(.*)$
type 7_VN_SUBCLASS vnclass matching ^vn:(.*)$
type 12_MCR_iliOffset ili matching ^mcr:ili-30-([0-9]+-[a-z])$
type 23_MCR_BLC ili matching ^mcr:ili-30-([0-9]+-[a-z])$
type 13_FN_FRAME fnframe matching ^fn:(.*)$
type 16_PB_ROLESET pbroleset matching ^pb:(.*)$
type 11_WN_SENSE ili matching ^wn:(.*)$
omit 6_VN_CLASS_NUMBER 8_VN_SUBCLASS_NUMBER 24_WN_SENSEFREC 25_WN_SYNSET_REL_NUM
content *
# A row is the one correspondence it states (BRIEF: a mapping row is one interchange, a path over the resolved highway
# nodes, never split into a claim per column). README: "Each row of this Predicate Matrix represents the mapping of a
# role over the different resources and includes all the aligned knowledge about its corresponding verb sense." The
# strand is that mapping: the nodes the row aligns (the ILI concept, the VerbNet class and subclass, the FrameNet frame,
# the PropBank roleset) and the role in each (the VerbNet thematic-role, the FrameNet frame element, the PropBank
# argument), in the matrix's order; what the matrix leaves NULL is in no strand. A column's header is in no claim.
thing row 12_MCR_iliOffset 5_VN_CLASS 7_VN_SUBCLASS 13_FN_FRAME 16_PB_ROLESET 10_VN_ROLE 15_FN_FRAME_ELEMENT 17_PB_ARG
itself row
# The aligned knowledge said of the mapping, each as README words its column ("this column contains the information of ..."):
# README: "1_ID_LANG: this column contains the language of the predicate."
relation "the language of the predicate" 1_ID_LANG
# README: "2_ID_POS: this columnn contains the part-of-speech of the predicate."
relation "the part-of-speech of the predicate" 2_ID_POS
# README: "3_ID_PRED: this column contains the predicate."
relation "the predicate" 3_ID_PRED
# README: "4_ID_ROLE: this column contains the role."
relation "the role" 4_ID_ROLE
# README: "9_VN_LEMA: this column contains the information of the verb lemma."
relation "the verb lemma" 9_VN_LEMA
# README: "11_WN_SENSE: this column contains the information of the word sense in WordNet."
relation "the word sense in WordNet" 11_WN_SENSE
# README: "14_FN_LE: this column contains the information of the corresponding lexical-entry in FrameNet."
relation "the corresponding lexical-entry in FrameNet" 14_FN_LE
# README: "18_MCR_BC: this column contains the information if the verb sense it is Base Concept or not in the MCR3.0."
relation "if the verb sense it is Base Concept or not in the MCR3.0" 18_MCR_BC
# README: "19_MCR_DOMAIN: this column contains the information of the WordNet domain aligned to WordNet 3.0 in the MCR3.0."
relation "the WordNet domain aligned to WordNet 3.0 in the MCR3.0" 19_MCR_DOMAIN
# README: "20_MCR_SUMO: this column contains the information of the AdimenSUMO in the MCR3.0."
relation "the AdimenSUMO in the MCR3.0" 20_MCR_SUMO
# README: "21_MCR_TO: this column contains the information of the MCR Top Ontology in the MCR3.0."
relation "the MCR Top Ontology in the MCR3.0" 21_MCR_TO
# README: "22_MCR_LEXNAME: this column contains the information of the MCR Lexicographical file name."
relation "the MCR Lexicographical file name" 22_MCR_LEXNAME
# README: "23_MCR_BLC: this column contains the information of the Base Level Concept of the WordNet verb sense in the MCR3.0."
relation "the Base Level Concept of the WordNet verb sense in the MCR3.0" 23_MCR_BLC
# README: "26_ESO_CLASS: this column contains the information of the class of the ESO ontology."
relation "the class of the ESO ontology" 26_ESO_CLASS
# README: "27_ESO_ROLE: this column contains the information of the role of the ESO ontology."
relation "the role of the ESO ontology" 27_ESO_ROLE
attest row 1_ID_LANG 2_ID_POS 3_ID_PRED 4_ID_ROLE 9_VN_LEMA 11_WN_SENSE 14_FN_LE 18_MCR_BC 19_MCR_DOMAIN 20_MCR_SUMO 21_MCR_TO 22_MCR_LEXNAME 23_MCR_BLC 26_ESO_CLASS 27_ESO_ROLE
maps row 12_MCR_iliOffset ili matching ^mcr:ili-30-([0-9]+-[a-z])$ to 5_VN_CLASS vnclass matching ^vn:(.*)$
maps row 12_MCR_iliOffset ili matching ^mcr:ili-30-([0-9]+-[a-z])$ to 13_FN_FRAME fnframe matching ^fn:(.*)$
maps row 12_MCR_iliOffset ili matching ^mcr:ili-30-([0-9]+-[a-z])$ to 16_PB_ROLESET pbroleset matching ^pb:(.*)$
maps row 11_WN_SENSE ili matching ^wn:(.*)$ to 5_VN_CLASS vnclass matching ^vn:(.*)$
maps row 11_WN_SENSE ili matching ^wn:(.*)$ to 13_FN_FRAME fnframe matching ^fn:(.*)$
maps row 11_WN_SENSE ili matching ^wn:(.*)$ to 16_PB_ROLESET pbroleset matching ^pb:(.*)$
maps row 5_VN_CLASS vnclass matching ^vn:(.*)$ to 13_FN_FRAME fnframe matching ^fn:(.*)$
maps row 16_PB_ROLESET pbroleset matching ^pb:(.*)$ to 5_VN_CLASS vnclass matching ^vn:(.*)$
maps row 16_PB_ROLESET pbroleset matching ^pb:(.*)$ to 13_FN_FRAME fnframe matching ^fn:(.*)$
