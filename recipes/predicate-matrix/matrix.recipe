name predicate-matrix
# PredicateMatrix v1.3 README: each row maps one role over all the resources.
# The first four columns identify that row. Preserve its language, predicate,
# role, lexicalizations, ontology values and stated frequency in that joint
# correspondence; a stated frequency is content, never a number of games.
match PredicateMatrix.v*.txt
tier row by \n
header
tier field by \t
empty NULL id:NULL vn:NULL wn:NULL mcr:NULL fn:NULL pb:NULL eso:NULL mcr:ili-30-NULL-v

# Resource-qualified references resolve through the cache. A class number or
# WordNet offset is a pointer, not the identifier text of the thing it names.
# Missing edition-specific pointers remain diagnosed; no newer class is guessed.
type 5_VN_CLASS vnclass matching ^vn:(.*)$
type 7_VN_SUBCLASS vnclass matching ^vn:(.*)$
# A sense key carries lexical facts as well as an ILI pointer. Its English
# lexicalization is shared with WordNet's [lemma, language, concept] identity;
# the packaging prefix and numeric sense key never become that identity.
part 11_WN_SENSE grammar wn_sense_key
thing 11_WN_SENSE of sense
thing sense lemma space _ literal eng reference
type sense.reference ili
type sense.lex_filenum lexfile
value lexfile sense.lex_filenum
relation "WordNet synset type" sense.ss_type
relation "WordNet lexical identifier" sense.lex_id
attest sense ss_type lex_filenum lex_id
type 12_MCR_iliOffset ili matching ^mcr:ili-30-([0-9]+-[a-z])$
type 23_MCR_BLC ili matching ^mcr:ili-30-([0-9]+-[a-z])$
type 13_FN_FRAME fnframe matching ^fn:(.*)$ node
type 16_PB_ROLESET pbroleset matching ^pb:(.*)$ node

# The other cells contain a literal value after one packaging namespace.
# Compiled chained field grammars select that value; no C corpus scanner.
part 1_ID_LANG by : pieces 2
part 2_ID_POS by : pieces 2
part 3_ID_PRED by : pieces 2
part 4_ID_ROLE by : pieces 2
part 9_VN_LEMA by : pieces 2
part 10_VN_ROLE by : pieces 2
part 14_FN_LE by : pieces 2
part 15_FN_FRAME_ELEMENT by : pieces 2
part 17_PB_ARG by : pieces 2
part 18_MCR_BC by : pieces 2
part 19_MCR_DOMAIN by : pieces 2
part 20_MCR_SUMO by : pieces 2
part 21_MCR_TO by : pieces 2
part 22_MCR_LEXNAME by : pieces 2
part 24_WN_SENSEFREC by : pieces 2
part 26_ESO_CLASS by : pieces 2
part 27_ESO_ROLE by : pieces 2

# These repeat class-number keys or database relationship bookkeeping.
omit 6_VN_CLASS_NUMBER 8_VN_SUBCLASS_NUMBER 25_WN_SYNSET_REL_NUM
content *
# All nonempty semantic cells, in source order, form ONE n-ary strand. A role
# pair's complete context stays together instead of playing its repeated
# role-independent column pairs as separate games.
thing 1_ID_LANG 2
thing 2_ID_POS 2
thing 3_ID_PRED 2
thing 4_ID_ROLE 2
thing 9_VN_LEMA 2
thing 10_VN_ROLE 2
# FrameNet qualifies LU/FE identifiers by their frame. A bare drop.v or Agent
# is not the highway identity [Body_movement, drop.v] or [Body_movement, Agent].
# Where the row supplies no frame, retain its unqualified source value.
thing 14_FN_LE ^/13_FN_FRAME 2
thing 14_FN_LE 2
thing 15_FN_FRAME_ELEMENT ^/13_FN_FRAME 2
thing 15_FN_FRAME_ELEMENT 2
thing 17_PB_ARG 2
thing 18_MCR_BC 2
thing 19_MCR_DOMAIN 2
thing 20_MCR_SUMO 2
thing 21_MCR_TO 2
thing 22_MCR_LEXNAME 2
thing 24_WN_SENSEFREC 2
thing 26_ESO_CLASS 2
thing 27_ESO_ROLE 2
thing row of *
itself row

# The cache builder may index crosswalk edges; these are not extra claims.
maps row 12_MCR_iliOffset ili matching ^mcr:ili-30-([0-9]+-[a-z])$ to 5_VN_CLASS vnclass matching ^vn:(.*)$
maps row 12_MCR_iliOffset ili matching ^mcr:ili-30-([0-9]+-[a-z])$ to 13_FN_FRAME fnframe matching ^fn:(.*)$
maps row 12_MCR_iliOffset ili matching ^mcr:ili-30-([0-9]+-[a-z])$ to 16_PB_ROLESET pbroleset matching ^pb:(.*)$
maps row 11_WN_SENSE ili matching ^wn:(.*)$ to 5_VN_CLASS vnclass matching ^vn:(.*)$
maps row 11_WN_SENSE ili matching ^wn:(.*)$ to 13_FN_FRAME fnframe matching ^fn:(.*)$
maps row 11_WN_SENSE ili matching ^wn:(.*)$ to 16_PB_ROLESET pbroleset matching ^pb:(.*)$
maps row 5_VN_CLASS vnclass matching ^vn:(.*)$ to 13_FN_FRAME fnframe matching ^fn:(.*)$
maps row 16_PB_ROLESET pbroleset matching ^pb:(.*)$ to 5_VN_CLASS vnclass matching ^vn:(.*)$
maps row 16_PB_ROLESET pbroleset matching ^pb:(.*)$ to 13_FN_FRAME fnframe matching ^fn:(.*)$
