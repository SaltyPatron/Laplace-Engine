name wsd-data
# A data set of the framework: texts of sentences, each sentence the words it is made of. The file does not write a
# sentence as text: a sentence is the path of its words, in order. What is said of a word (its lemma, its pos) is said
# of the word within its sentence: a sentence's claims are said together. The ids (d000.s000.t000) are the framework's
# keys to its texts, sentences and instances; the gold keys and system answers that point at them by those ids are
# not read.
match *.data.xml
format xml

thing wf wf
thing instance instance
thing sentence of wf instance
key sentence id
key instance id
key text id
# the data set a sentence is from (semeval2015, senseval2) is the framework's bookkeeping
omit source
content wf instance lemma pos lang
attest corpus lang
attest wf lemma pos
attest instance lemma pos
together sentence
