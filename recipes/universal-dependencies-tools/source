name universal-dependencies-tools
# The data of Universal Dependencies' validator: the tags, relations and features the project permits, language by
# language, and its auxiliaries and tokens with spaces. The repository names itself "tools", of UniversalDependencies.
witness UniversalDependencies tools
# The deviation is this recipe's choice for a curated academic resource; the specification does not give one.
deviation 90
root $LAPLACE_DATA/.refresh-*/UD-Tools/*/data
# Measured when it was loaded: 388,693 compositions from 6.7 MB, at 750 bytes each with their indexes and standings.
room 44
after unicode iso-639
