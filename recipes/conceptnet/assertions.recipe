name conceptnet-assertions
# Downloads.md: URI, relation, start, end, then JSON metadata, without a header.
# URI-hierarchy.md defines a concept's language, lemma and optional WordNet POS.
# The qualifier is retained in its original source notation.
match assertions.csv conceptnet-assertions-5.7.0.csv

tier edge by \n
names uri rel start end json
tier field by \t
part rel by / pieces 2
part start grammar concept_uri
part end grammar concept_uri
part lemma by \t space _
part pos grammar wordnet_category
part json grammar json

# Compare the parsed relation value, rather than its packaging group.
where rel/2 is-not ExternalURL
omit uri dataset license process activity surfaceStart surfaceEnd external
content lemma pos qualifier weight surfaceText contributor
type lexicalization.language language

# Universal POS is attached beside the source's own category, so adjective
# satellites keep their 's' identity while sharing the ADJ highway class.
type pos.category upos vocabulary wordnet-pos

thing concept resolved lexicalization/lemma required lexicalization/language required pos pos/category qualifier
thing edge preserve start rel/2 end
itself edge with json/sources/contributor

# Edges.md: strength and the original natural-language statement are claims
# about the edge, not JSON member names used as relation vertices.
relation "the strength with which this edge expresses this assertion" json.weight
relation "the original natural language text" json.surfaceText
attest edge json
