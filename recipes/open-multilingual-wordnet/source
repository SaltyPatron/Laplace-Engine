name open-multilingual-wordnet
# Open Multilingual Wordnet: wordnets of many languages aligned to Princeton WordNet 3.0's synsets, and through CILI
# to concepts. These recipes read the 1.x tab files. OMW 2.0, in the refresh, is WN-LMF and has no recipe yet.
# English is Princeton WordNet's own and is not read from here.
root $LAPLACE_DATA/OMW/wns
except */wns/eng/*
after cili iso-639
