name wordframenet-xwfn
# XWFN/eXtendedWFN uses the same frame/lexical-row packaging as WFN.
# Its rows usually have no definition; absence adds no synthetic operand.
match eXtendedWFN
format frame_lexicon

thing frame header/name
type header.name fnframe node
content *
thing reference literal WordNet literal 1.6 offset category
thing lexicalization preserve spelling space _ literal eng ^entry/reference
thing entry resolved preserve ^frame/header/name required lexicalization required pos required annotation definition
itself entry
