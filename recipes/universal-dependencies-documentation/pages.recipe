name ud-documentation
# A page of the Universal Dependencies documentation. Its front matter names what the page is about (title: 'NOUN')
# and gives a short definition of it (shortdef: 'noun'). A heading that names a value (### <a name="Sing">`Sing`</a>:
# singular number) says, of what the page is about, the value and what it is called: [Number, Sing] is called
# "singular number".
match *.md

tier line by \n

# UD's source tree also contains headerless feature pages (e.g. _mpu/feat/Red.md).
# Their basename names the feature; prefer an explicit title where supplied.
about ^title *: *'(.*)'$ else {file}
# UD's front matter gives a short definition of the page's named subject.
# A value heading names a value WITHIN that feature: Poss=Yes must remain
# distinct from Abbr=Yes, Foreign=Yes and the other Boolean features.
line ^shortdef *: *'(.*)'$ :: relation "short definition"
line ^### <a name="[^"]*">`([^`]+)`</a>: (.*)$ :: relation "called" within
