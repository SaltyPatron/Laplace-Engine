cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED WORK)
  message(FATAL_ERROR "Use -DWORK=<test output directory>")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/ReaderContract.cmake")
file(MAKE_DIRECTORY "${WORK}/engine/src" "${WORK}/native/src" "${WORK}/tree/src")
file(REMOVE "${WORK}/engine/src/new_reader.h")
foreach(part IN ITEMS engine native tree)
  file(WRITE "${WORK}/${part}/src/reader.c" "reading implementation\n")
endforeach()
set(query_sources src/query.c src/query.h)
file(WRITE "${WORK}/engine/src/query.c" "query implementation\n")
file(WRITE "${WORK}/engine/src/query.h" "query declarations\n")
function(measure out)
  laplace_reader_source_id(value "${WORK}/engine" "${WORK}/native" "${WORK}/tree" "${query_sources}")
  set(${out} "${value}" PARENT_SCOPE)
endfunction()
measure(before)
file(APPEND "${WORK}/engine/src/query.c" "a query-only repair\n")
file(APPEND "${WORK}/engine/src/query.h" "another query operation\n")
measure(after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "A query change invalidated unchanged corpus readings")
endif()
foreach(part IN ITEMS engine native tree)
  file(APPEND "${WORK}/${part}/src/reader.c" "changed reading semantics\n")
  measure(changed)
  if(changed STREQUAL after)
    message(FATAL_ERROR "${part} reader changes did not invalidate prior readings")
  endif()
  set(after "${changed}")
endforeach()
file(WRITE "${WORK}/engine/src/new_reader.h" "a new reading dependency\n")
measure(changed)
if(changed STREQUAL after)
  message(FATAL_ERROR "A new reading header did not invalidate prior readings")
endif()
message(STATUS "Reader contract: query policy is independent; reader, Native, grammar and new-header changes invalidate")
