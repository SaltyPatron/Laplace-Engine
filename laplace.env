# Laplace's environment: the one definition of where everything is. Source it before building or running anything.
# Every Laplace build (Laplace-Native, Laplace-postgres, Laplace-Engine) and the laplace program read these; what is
# not set here falls back to the same defaults, compiled in.
#
#   source /repos/src/Laplace-Engine/laplace.env

export LAPLACE_SRC=${LAPLACE_SRC:-/repos/src}                  # Laplace's repositories and its dependencies' sources
export LAPLACE_BUILD=${LAPLACE_BUILD:-/repos/build}            # build trees
export LAPLACE_WORK=${LAPLACE_WORK:-/repos/work}               # generated data and logs
export LAPLACE_DEPS=${LAPLACE_DEPS:-/repos/deps}               # installed dependencies
export LAPLACE_DATA=${LAPLACE_DATA:-/vault/Data}               # corpora and the Unicode data

# The machine, as setup.sh declares it (Operations: Setup, Database). Every name here is this installation's choice.
export LAPLACE_PREFIX=${LAPLACE_PREFIX:-/usr/local}            # where the dependencies built from source install
export LAPLACE_PG_DIR=${LAPLACE_PG_DIR:-/usr/local/pgsql}      # PostgreSQL 18, built with icx
export LAPLACE_PGDATA=${LAPLACE_PGDATA:-/data/pgdata}          # the cluster: heap and indexes
export LAPLACE_PGWAL=${LAPLACE_PGWAL:-$LAPLACE_PGDATA/pg_wal}  # its write-ahead log, on its own volume
export LAPLACE_PGTEMP=${LAPLACE_PGTEMP:-/data/pgtemp}          # its temporary files, a tablespace on its own volume
export LAPLACE_PGUSER=${LAPLACE_PGUSER:-postgres}              # the operating-system user the server runs as
export LAPLACE_PGSERVICE=${LAPLACE_PGSERVICE:-pgdata}          # the systemd unit
export LAPLACE_ROLE=${LAPLACE_ROLE:-laplace}                   # the database role Laplace connects as
export LAPLACE_LAN=${LAPLACE_LAN:-192.168.1.0/24}              # the network the server is reachable from
export LAPLACE_VOLUMES=${LAPLACE_VOLUMES:-"
vg-data    lv-postgres  740G  xfs  $LAPLACE_PGDATA   heap and indexes: the fastest drive
vg-wal     lv-wal        64G  xfs  $LAPLACE_PGWAL    write-ahead log: its own SSD
vg-wal     lv-pgtemp     64G  xfs  $LAPLACE_PGTEMP   temporary files: its own SSD
vg-repo    lv-repo      128G  xfs  /repos            sources, builds, work: an SSD
vg-vault   lv-vault      ALL  xfs  /vault            data sets and archives: bulk
"}                                                            # vg lv size fs mount: what Laplace keeps apart; an existing volume is never resized or reformatted
# The agent: a GitHub Actions runner on this machine as its own user, separate from anyone's development environment,
# with the one right it needs (setup.sh as root). Its sources, builds and work are under its home.
export LAPLACE_GITHUB=${LAPLACE_GITHUB:-SaltyPatron}           # the account or organisation the repositories are under
export LAPLACE_AGENT_REPO=${LAPLACE_AGENT_REPO:-Laplace-Engine}   # the repository whose workflows run on the agent
export LAPLACE_AGENT_USER=${LAPLACE_AGENT_USER:-laplace-runner}
export LAPLACE_AGENT_HOME=${LAPLACE_AGENT_HOME:-/var/lib/agents/laplace-runner}
export LAPLACE_AGENT_LABELS=${LAPLACE_AGENT_LABELS:-laplace}
export LAPLACE_GROUP=${LAPLACE_GROUP:-laplace-runner}         # the group the operator and the agent share: every shared tree is its, group-writable
export LAPLACE_PG_GROUP=${LAPLACE_PG_GROUP:-postgres-extensions}   # the group that may install extensions into $LAPLACE_PG_DIR

export LAPLACE_NATIVE=$LAPLACE_SRC/Laplace-Native
export LAPLACE_SQL=$LAPLACE_SRC/Laplace-postgres/sql
export LAPLACE_RECIPES=$LAPLACE_SRC/Laplace-Engine/recipes
export LAPLACE_FIRMWARE=${LAPLACE_FIRMWARE:-$LAPLACE_SRC/Laplace-Engine/firmware/program.firmware}   # the firmware a pull runs under: one for each human being
export LAPLACE_TIER0=$LAPLACE_WORK/tier0/tier0.bin             # laplace tier0 writes it; every install with its fingerprint agrees
export LAPLACE_GRAMMARS=$LAPLACE_BUILD/grammars                # tools/build_grammars.sh writes them
export LAPLACE_UCD=$LAPLACE_DATA/UCD
export LAPLACE_ICU_DIR=$LAPLACE_DEPS/icu78                     # ICU 78: Unicode 17, the version tier 0 is built from
export LAPLACE_CONNINFO="${LAPLACE_CONNINFO:-host=/tmp port=5432 user=$LAPLACE_ROLE dbname=laplace_engine}"    # libpq form; names the database

# Every core: some shells and agents set these to 1, which makes every kernel single-threaded.
export OMP_NUM_THREADS=$(nproc) MKL_NUM_THREADS=$(nproc)

# The toolchain: Intel oneAPI (icx, MKL), and the PostgreSQL the extension is built for.
source /opt/intel/oneapi/setvars.sh >/dev/null 2>&1 || true
export PG_CONFIG=$LAPLACE_PG_DIR/bin/pg_config
export PATH=$LAPLACE_BUILD/Laplace-Engine/icx-release:$LAPLACE_PG_DIR/bin:$HOME/.local/bin:$PATH
